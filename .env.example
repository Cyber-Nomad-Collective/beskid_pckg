# Copy to .env for local compose, or set the same keys in Coolify.

# Bundled Postgres (shared with ConnectionStrings__DefaultConnection in docker-compose.yml)
POSTGRES_DB=pckgdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Host/port the app uses to reach Postgres (compose default: service name "postgres")
PCKG_DB_HOST=postgres
PCKG_DB_PORT=5432

# Paired service token issued by site/auth for app=pckg; keep it secret.
PCKG_AUTH_HUB_SERVICE_TOKEN=
# Separate 32+ character secret used only to sign pckg browser sessions.
PCKG_SESSION_SECRET=
# Keep `true` in HTTPS deployments. Local Docker compose defaults to `false`.
PCKG_COOKIE_SECURE=true
