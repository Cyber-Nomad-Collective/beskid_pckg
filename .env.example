# Copy to .env for local Compose. Production values are rendered by the root
# GitHub delivery workflow from OpenBao-backed environment configuration.

# Bundled Postgres for local Compose. Use URL-safe values here. Production does
# not assemble a connection URL from these fragments; the root delivery path
# injects one encoded PCKG_DATABASE_URL from the environment secret manager.
POSTGRES_DB=pckgdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Host/port the app uses to reach Postgres (Compose default: service name "postgres").
PCKG_DB_HOST=postgres
PCKG_DB_PORT=5432

# Local filesystem artifact root inside the container. Keep it on the managed
# pckg_packages volume unless an object-storage adapter replaces it.
PCKG_ARTIFACT_ROOT=/app/packages

# Local development mints one deterministic administrator. Production either
# leaves this unset (CLI bearer publication only) or uses `authelia` behind a
# proxy that strips client Remote-* headers before forward-auth injection.
SHELL_AUTH_MODE=mock
SHELL_MOCK_SUBJECT=local-admin
SHELL_MOCK_GROUPS=pckg-admins
SHELL_ADMIN_GROUP=pckg-admins
SHELL_MODERATOR_GROUP=pckg-moderators
