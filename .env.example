# Copy to .env for local compose, or set the same keys in Coolify.

# Bundled Postgres (shared with ConnectionStrings__DefaultConnection in docker-compose.yml)
POSTGRES_DB=pckgdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Host/port the app uses to reach Postgres (compose default: service name "postgres")
PCKG_DB_HOST=postgres
PCKG_DB_PORT=5432

# Optional: set ConnectionStrings__DefaultConnection in Coolify to a full Npgsql string instead of relying on compose expansion.
# Run EF migrations on container start (true|false)
PCKG_AUTO_MIGRATE_ON_STARTUP=true

ASPNETCORE_ENVIRONMENT=Production
HTTP_PORTS=8082
HTTP_CLIENT_INTERNAL_BASE_ADDRESS=http://127.0.0.1:8082
