@inject IDocumentationRendering DocumentationRendering
@inject NavigationManager Navigation

@if (_hasContent)
{
    <div class="docs-markdown-body">
        @((MarkupString)_html)
    </div>
}
else
{
    <FluentLabel Typo="Typography.Body" Class="muted">No description.</FluentLabel>
}

@code {
    private string _html = string.Empty;
    private bool _hasContent;

    [Parameter]
    public string? Markdown { get; set; }

    protected override void OnParametersSet()
    {
        var raw = Markdown ?? string.Empty;
        if (string.IsNullOrWhiteSpace(raw))
        {
            _html = string.Empty;
            _hasContent = false;
            return;
        }

        var path = new Uri(Navigation.Uri).AbsolutePath;
        _html = DocumentationRendering.RenderPackageMarkdown(raw, path);
        _hasContent = true;
    }
}
