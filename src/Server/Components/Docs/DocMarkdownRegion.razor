@using Microsoft.AspNetCore.Components
@using Server.Services
@inject IMarkdownService MarkdownService
@inject IHtmlSanitizationService HtmlSanitization
@inject NavigationManager Navigation

<div class="docs-markdown-body">
    @_html
</div>

@code {
    private MarkupString _html = default;

    [Parameter]
    public string? Markdown { get; set; }

    protected override void OnParametersSet()
    {
        var raw = Markdown ?? string.Empty;
        if (string.IsNullOrWhiteSpace(raw))
        {
            _html = new MarkupString("<p class=\"muted\">No description.</p>");
            return;
        }

        var safe = MarkdownService.ToSafeHtml(raw);
        var sanitized = HtmlSanitization.Sanitize(safe);
        var path = new Uri(Navigation.Uri).AbsolutePath;
        var rewritten = DocumentationAnchorRewriter.RewriteDocumentationAnchors(sanitized, path);
        _html = new MarkupString(rewritten);
    }
}
