@if (Item is not null)
{
    <FluentStack Orientation="Orientation.Vertical" Gap="8" Class="package-docs-member-header">
        @if (Breadcrumbs.Count > 0)
        {
            <FluentBreadcrumb Class="package-docs-breadcrumbs" aria-label="Breadcrumb">
                <FluentBreadcrumbItem>
                    @Item.DisplayName
                </FluentBreadcrumbItem>
    
                @foreach (var crumb in Breadcrumbs)
                {
                    <FluentBreadcrumbItem>
                        @if (crumb.Selectable && OnBreadcrumbSelected.HasDelegate)
                        {
                            <FluentButton Appearance="Appearance.Stealth"
                                          Class="package-docs-breadcrumb-link"
                                          OnClick="@(() => OnBreadcrumbSelected.InvokeAsync(crumb.Item!))">
                                @crumb.Label
                            </FluentButton>
                        }
                        else
                        {
                            <FluentLabel Typo="Typography.Body" Class="muted package-docs-breadcrumb-label">@crumb.Label</FluentLabel>
                        }
                    </FluentBreadcrumbItem>
                }
            </FluentBreadcrumb>
        }
        <FluentStack Orientation="Orientation.Horizontal"
                     VerticalAlignment="VerticalAlignment.Center"
                     Wrap="true"
                     Gap="8"
                     Class="package-docs-member-title-row">
            <FluentLabel Typo="Typography.H5" Class="package-docs-member-title">
                @(Item.QualifiedName ?? Item.DisplayName ?? Item.Name ?? "Member")
            </FluentLabel>
            @if (!string.IsNullOrWhiteSpace(MemberPageUrl))
            {
                <FluentButton Appearance="Appearance.Outline"
                              IconStart="@(new Icons.Regular.Size20.Link())"
                              Title="Copy link to this member"
                              OnClick="CopyMemberLinkAsync">
                    Copy link
                </FluentButton>
            }
        </FluentStack>
        @if (!string.IsNullOrWhiteSpace(Item.Signature))
        {
            <code class="package-docs-signature">@Item.Signature</code>
        }
        <FluentStack Orientation="Orientation.Horizontal" Wrap="true" Gap="6" VerticalAlignment="VerticalAlignment.Center">
            @if (!string.IsNullOrWhiteSpace(Item.Kind))
            {
                <FluentBadge Appearance="Appearance.Lightweight">@Item.Kind</FluentBadge>
            }
            @if (!string.IsNullOrWhiteSpace(Item.Visibility))
            {
                <FluentBadge Appearance="Appearance.Neutral">@Item.Visibility</FluentBadge>
            }
            @if (ShowSourceLocation && Item.Location is { } loc)
            {
                <FluentLabel Typo="Typography.Body" Class="muted">@loc.File:@loc.StartLine</FluentLabel>
            }
            else if (ShowExternalDeclaringPackage)
            {
                <FluentLabel Typo="Typography.Body" Class="muted">@Item.DeclaringPackage</FluentLabel>
            }
        </FluentStack>
    </FluentStack>
}

@code {
    [Parameter]
    public StructuredApiItemDto? Item { get; set; }

    [Parameter]
    public string PackageIdentifier { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<PackageDocsBreadcrumb> Breadcrumbs { get; set; } = Array.Empty<PackageDocsBreadcrumb>();

    private bool ShowSourceLocation =>
        Item?.Location is not null
        && (string.IsNullOrWhiteSpace(Item.DeclaringPackage)
            || string.Equals(
                Item.DeclaringPackage.Trim(),
                PackageIdentifier.Trim(),
                StringComparison.OrdinalIgnoreCase));

    private bool ShowExternalDeclaringPackage =>
        !ShowSourceLocation
        && !string.IsNullOrWhiteSpace(Item?.DeclaringPackage);

    [Parameter]
    public string? MemberPageUrl { get; set; }

    [Parameter]
    public EventCallback<StructuredApiItemDto> OnBreadcrumbSelected { get; set; }

    [Inject]
    private IJSRuntime Js { get; set; } = default!;

    private async Task CopyMemberLinkAsync()
    {
        if (string.IsNullOrWhiteSpace(MemberPageUrl))
        {
            return;
        }

        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", MemberPageUrl);
        }
        catch
        {
            // Clipboard may be unavailable outside a secure context.
        }
    }
}
