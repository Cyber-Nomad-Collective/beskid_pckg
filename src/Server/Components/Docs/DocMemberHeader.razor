@using Microsoft.FluentUI.AspNetCore.Components
@using Server.Contracts.ApiDocumentation

@if (Item is not null)
{
    <FluentStack Orientation="Orientation.Vertical" Gap="8" Class="package-docs-member-header">
        <FluentLabel Typo="Typography.H5" Class="package-docs-member-title">
            @(Item.QualifiedName ?? Item.DisplayName ?? Item.Name ?? "Member")
        </FluentLabel>
        @if (!string.IsNullOrWhiteSpace(Item.Signature))
        {
            <code class="package-docs-signature">@Item.Signature</code>
        }
        <FluentStack Orientation="Orientation.Horizontal" Wrap="true" Gap="6" VerticalAlignment="VerticalAlignment.Center">
            @if (!string.IsNullOrWhiteSpace(Item.Kind))
            {
                <FluentBadge Appearance="Appearance.Lightweight">@Item.Kind</FluentBadge>
            }
            @if (!string.IsNullOrWhiteSpace(Item.Visibility))
            {
                <FluentBadge Appearance="Appearance.Neutral">@Item.Visibility</FluentBadge>
            }
            @if (Item.Location is { } loc)
            {
                <FluentLabel Typo="Typography.Body" Class="muted">@loc.File:@loc.StartLine</FluentLabel>
            }
        </FluentStack>
    </FluentStack>
}

@code {
    [Parameter]
    public StructuredApiItemDto? Item { get; set; }
}
