@using System.Text.Json
@if (_type == "see_also")
{
    <DocSeeAlso Control="Control" OnNavigateQualifiedName="OnNavigateQualifiedName" />
}

@code {
    private string? _type;

    [Parameter]
    public JsonElement Control { get; set; }

    [Parameter]
    public EventCallback<string> OnNavigateQualifiedName { get; set; }

    protected override void OnParametersSet()
    {
        _type = null;
        if (Control.ValueKind == JsonValueKind.Object
            && Control.TryGetProperty("type", out var t)
            && t.ValueKind == JsonValueKind.String)
        {
            _type = t.GetString();
        }
    }
}
