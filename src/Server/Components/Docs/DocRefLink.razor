<FluentButton Appearance="Appearance.Stealth"
              Class="docs-ref-link"
              Title="@QualifiedName"
              OnClick="ClickAsync">
    @DisplayText
</FluentButton>

@code {
    [Parameter]
    public string QualifiedName { get; set; } = string.Empty;

    [Parameter]
    public string? DisplayText { get; set; }

    [Parameter]
    public EventCallback<string> OnNavigateQualifiedName { get; set; }

    private async Task ClickAsync()
    {
        if (!string.IsNullOrWhiteSpace(QualifiedName))
        {
            await OnNavigateQualifiedName.InvokeAsync(QualifiedName);
        }
    }
}
