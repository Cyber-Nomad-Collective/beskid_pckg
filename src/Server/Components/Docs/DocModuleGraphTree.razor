@using Microsoft.FluentUI.AspNetCore.Components

<FluentStack Orientation="Orientation.Vertical" Gap="4" Class="docs-module-tree">
    @if (ShowPackageSummary)
    {
        <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">@(string.IsNullOrWhiteSpace(PackageName) ? "Package" : PackageName)</FluentLabel>
        <FluentLabel Typo="Typography.Body" Class="muted docs-module-tree-meta">
            @PackageName @Version
        </FluentLabel>
    }
    <div class="docs-module-tree-scroll">
        <FluentTreeView Class="docs-module-tree-view">
            @foreach (var root in Roots)
            {
                <DocModuleGraphTreeItem Node="root"
                                        SelectedItemId="SelectedItemId"
                                        SelectedQualifiedName="SelectedQualifiedName"
                                        ExpandedIds="ExpandedIds"
                                        ForceExpandAll="ForceExpandAll"
                                        OnToggleExpand="OnToggleExpand"
                                        OnItemSelected="OnItemSelected" />
            }
        </FluentTreeView>
    </div>
</FluentStack>

@code {
    [Parameter]
    public IReadOnlyList<GraphNavNode> Roots { get; set; } = Array.Empty<GraphNavNode>();

    [Parameter]
    public string PackageName { get; set; } = string.Empty;

    [Parameter]
    public string Version { get; set; } = "latest";

    [Parameter]
    public int? SelectedItemId { get; set; }

    [Parameter]
    public string? SelectedQualifiedName { get; set; }

    [Parameter]
    public IReadOnlySet<int> ExpandedIds { get; set; } = new HashSet<int>();

    [Parameter]
    public bool ForceExpandAll { get; set; }

    [Parameter]
    public EventCallback<int> OnToggleExpand { get; set; }

    [Parameter]
    public EventCallback<StructuredApiItemDto> OnItemSelected { get; set; }

    [Parameter]
    public bool ShowPackageSummary { get; set; } = true;
}
