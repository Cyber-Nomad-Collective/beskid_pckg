<FluentDataGrid TGridItem="PackageDocsSymbolRow"
                Items="@SymbolRowsQueryable"
                DisplayMode="DataGridDisplayMode.Table"
                Class="package-docs-data-grid package-docs-symbol-grid">
    <TemplateColumn Title="Name" Context="row">
        <FluentButton Appearance="Appearance.Stealth"
                      Class="docs-file-link"
                      Title="@row.DisplayName"
                      OnClick="@(() => OnSelect.InvokeAsync(row.Item))">
            @row.DisplayName
        </FluentButton>
    </TemplateColumn>
    <PropertyColumn Property="@(row => row.Kind)" Title="Kind" />
    <PropertyColumn Property="@(row => row.Parent)" Title="Parent" />
    <PropertyColumn Property="@(row => row.Visibility)" Title="Visibility" />
</FluentDataGrid>

@code {
    [Parameter] public IReadOnlyList<PackageDocsSymbolRow> Rows { get; set; } = [];
    [Parameter] public EventCallback<StructuredApiItemDto> OnSelect { get; set; }

    private IQueryable<PackageDocsSymbolRow> SymbolRowsQueryable => Rows.AsQueryable();
}
