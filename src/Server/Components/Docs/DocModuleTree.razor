<FluentStack Orientation="Orientation.Vertical" Gap="4" Class="docs-module-tree">
    <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">API</FluentLabel>
    <div class="docs-nav-list docs-module-tree-scroll">
        @foreach (var seg in _root.ChildSegments)
        {
                        <DocModuleTreeNode SegmentName="@seg"
                               Node="@(_root.Children[seg])"
                               Depth="0"
                               SelectedItemId="SelectedItemId"
                               SelectedQualifiedName="SelectedQualifiedName"
                               OnItemSelected="OnItemSelected" />
        }
        @foreach (var m in _root.Members.OrderBy(x => x.QualifiedName ?? x.Name, StringComparer.Ordinal))
        {
            <FluentButton Appearance="@ButtonAppearance(m)"
                          Class="docs-file-link"
                          Style="padding-left: 0.25rem;"
                          Title="@(m.QualifiedName ?? m.Name)"
                          OnClick="@(() => SelectAsync(m))">
                @(ShortName(m))
            </FluentButton>
        }
    </div>
</FluentStack>

@code {
    private NavTreeNode _root = new();

    [Parameter]
    public IReadOnlyList<StructuredApiItemDto> Items { get; set; } = Array.Empty<StructuredApiItemDto>();

    [Parameter]
    public int? SelectedItemId { get; set; }

    [Parameter]
    public string? SelectedQualifiedName { get; set; }

    [Parameter]
    public EventCallback<StructuredApiItemDto> OnItemSelected { get; set; }

    protected override void OnParametersSet() => Rebuild();

    private void Rebuild()
    {
        _root = new NavTreeNode();
        foreach (var item in Items)
        {
            var q = item.QualifiedName ?? item.Name ?? string.Empty;
            var segs = q.Split("::", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            if (segs.Length == 0)
            {
                continue;
            }

            if (segs.Length == 1)
            {
                _root.Members.Add(item);
                continue;
            }

            var node = _root;
            for (var i = 0; i < segs.Length - 1; i++)
            {
                node = node.GetOrAddChild(segs[i]);
            }

            node.Members.Add(item);
        }
    }

    private static string ShortName(StructuredApiItemDto m)
    {
        var q = m.QualifiedName ?? m.Name ?? "";
        var segs = q.Split("::", StringSplitOptions.RemoveEmptyEntries);
        return segs.Length > 0 ? segs[^1] : q;
    }

    private Appearance ButtonAppearance(StructuredApiItemDto m)
    {
        if (SelectedItemId is int id && m.Id == id)
        {
            return Appearance.Accent;
        }

        var key = m.QualifiedName ?? m.Name;
        if (!string.IsNullOrEmpty(SelectedQualifiedName)
            && string.Equals(key, SelectedQualifiedName, StringComparison.Ordinal))
        {
            return Appearance.Accent;
        }

        return Appearance.Stealth;
    }

    private Task SelectAsync(StructuredApiItemDto m) => OnItemSelected.InvokeAsync(m);
}
