@inject NavigationManager Navigation

<FluentStack Orientation="Orientation.Vertical" Gap="4" Class="package-docs-toc-shell">
    @if (!string.IsNullOrWhiteSpace(Heading))
    {
        <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold" Class="package-docs-toc-heading">@Heading</FluentLabel>
    }
    @if (Rows.Count == 0)
    {
        <FluentLabel Typo="Typography.Body" Class="muted">No headings in this article.</FluentLabel>
    }
    else
    {
        <nav class="package-docs-toc-nav" aria-label="@Heading">
            <FluentStack Orientation="Orientation.Vertical" Gap="2" Class="package-docs-toc-list">
                @foreach (var row in Rows)
                {
                    var pad = Math.Clamp((row.Level - 2) * 0.65, 0, 4);
                    <FluentAnchor Href="@FragmentHref(row.Anchor)"
                                  Class="docs-file-link package-docs-toc-link package-docs-toc-item"
                                  Style="@($"padding-inline-start: {pad.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}rem")">
                        @row.Title
                    </FluentAnchor>
                }
            </FluentStack>
        </nav>
    }
</FluentStack>

@code {
    [Parameter]
    public string? Heading { get; set; }

    [Parameter]
    public IReadOnlyList<PackageDocsTocRow> Rows { get; set; } = [];

    private string FragmentHref(string anchor)
    {
        var path = new Uri(Navigation.Uri).AbsolutePath;
        return $"{path}#{anchor}";
    }
}
