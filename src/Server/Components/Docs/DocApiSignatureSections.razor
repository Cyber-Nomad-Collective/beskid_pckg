@using Server.Contracts.ApiDocumentation

@if (Item is not null)
{
    @if (Item.ReturnType is not null)
    {
        <FluentStack Orientation="Orientation.Vertical" Gap="6">
            <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">Returns</FluentLabel>
            <DocTypeLink Annotation="@Item.ReturnType"
                         PackageIdentifier="@PackageIdentifier"
                         Version="@Version"
                         ItemsById="@ItemsById"
                         OnNavigate="OnTypeRefSelected" />
        </FluentStack>
    }
    @if (Item.Parameters.Count > 0)
    {
        <FluentStack Orientation="Orientation.Vertical" Gap="6">
            <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">Parameters</FluentLabel>
            <FluentDataGrid TGridItem="ApiParameterDocDto"
                            Items="@ParameterRows"
                            DisplayMode="DataGridDisplayMode.Table"
                            Class="package-docs-data-grid">
                <PropertyColumn Property="@(p => p.Name)" Title="Name" />
                <TemplateColumn Title="Type" Context="param">
                    <DocTypeLink Annotation="@param.Ty"
                                 PackageIdentifier="@PackageIdentifier"
                                 Version="@Version"
                                 ItemsById="@ItemsById"
                                 OnNavigate="OnTypeRefSelected" />
                </TemplateColumn>
                <TemplateColumn Title="Modifier" Context="param">
                    @(string.IsNullOrWhiteSpace(param.Modifier) ? "-" : param.Modifier)
                </TemplateColumn>
            </FluentDataGrid>
        </FluentStack>
    }
    @if (Item.GenericParameters.Count > 0)
    {
        <FluentStack Orientation="Orientation.Vertical" Gap="6">
            <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">Generic parameters</FluentLabel>
            <FluentLabel Typo="Typography.Body">@string.Join(", ", Item.GenericParameters.Select(g => g.Name))</FluentLabel>
        </FluentStack>
    }
    @if (Item.FieldType is not null && Item.Parameters.Count == 0 && Item.ReturnType is null)
    {
        <FluentStack Orientation="Orientation.Vertical" Gap="6">
            <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">Type</FluentLabel>
            <DocTypeLink Annotation="@Item.FieldType"
                         PackageIdentifier="@PackageIdentifier"
                         Version="@Version"
                         ItemsById="@ItemsById"
                         OnNavigate="OnTypeRefSelected" />
        </FluentStack>
    }
}

@code {
    [Parameter]
    public StructuredApiItemDto? Item { get; set; }

    [Parameter]
    public string PackageIdentifier { get; set; } = string.Empty;

    [Parameter]
    public string Version { get; set; } = "latest";

    [Parameter]
    public IReadOnlyDictionary<int, StructuredApiItemDto>? ItemsById { get; set; }

    [Parameter]
    public EventCallback<int> OnTypeRefSelected { get; set; }

    private IQueryable<ApiParameterDocDto> ParameterRows =>
        (Item?.Parameters ?? []).AsQueryable();
}
