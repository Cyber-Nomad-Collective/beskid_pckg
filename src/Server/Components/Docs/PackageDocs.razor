@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

<div class="@($"docs-browser-root {(Variant == PackageDocs.PackageDocsVariant.FullPage ? "docs-browser-root--full" : "docs-browser-root--embedded")} package-docs-shell")">
    @if (_loading)
    {
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Gap="12" Wrap="true" Class="docs-state-inline">
            <FluentProgressRing />
            <FluentLabel Typo="Typography.Body">Loading API documentation…</FluentLabel>
        </FluentStack>
    }
    else if (_loadError is not null)
    {
        <FluentMessageBar Intent="MessageIntent.Warning">@_loadError</FluentMessageBar>
    }
    else if (_doc is not null)
    {
        <div class="package-docs-content">
            @if (!string.IsNullOrWhiteSpace(_deepLinkMissMessage))
            {
                <FluentMessageBar Intent="MessageIntent.Warning">@_deepLinkMissMessage</FluentMessageBar>
            }

            @if (!string.IsNullOrWhiteSpace(_doc.Source) || _doc.SchemaVersion > 0)
            {
                <FluentStack Orientation="Orientation.Horizontal" Wrap="true" Gap="6" Class="muted package-docs-meta-row">
                    @if (_doc.SchemaVersion > 0)
                    {
                        <FluentBadge Appearance="Appearance.Neutral">schema @(_doc.SchemaVersion)</FluentBadge>
                    }
                    @if (!string.IsNullOrWhiteSpace(_doc.Source))
                    {
                        <FluentLabel Typo="Typography.Body" Class="muted">@_doc.Source</FluentLabel>
                    }
                </FluentStack>
            }

            <div class="package-docs-main-grid">
                <div class="package-docs-nav-col">
                    <DocModuleTree Items="@FilteredItems.ToList()"
                                   PackageName="@PackageIdentifier"
                                   Version="@Version"
                                   ShowPackageSummary="@(Variant != PackageDocs.PackageDocsVariant.FullPage)"
                                   GroupBy="@_groupBy"
                                   SelectedItemId="@_selected?.Id"
                                   SelectedQualifiedName="@(_selected?.QualifiedName ?? _selected?.Name)"
                                   OnItemSelected="SelectItemAsync" />
                </div>

                <div class="package-docs-article-col">
                    <FluentStack Orientation="Orientation.Vertical" Gap="12">
                        @if (_selected is not null)
                        {
                            <DocMemberHeader Item="@_selected" />
                            @if (_selected.Controls is { Length: > 0 } ctrls)
                            {
                                @foreach (var c in ctrls)
                                {
                                    <DocDynamicControl Control="c" OnNavigateQualifiedName="NavigateToQualifiedNameAsync" />
                                }
                            }
                            <DocMarkdownRegion Markdown="@_selected.DocMarkdown" />
                        }
                        else
                        {
                            <FluentLabel Typo="Typography.Body" Class="muted">Select a member from the tree.</FluentLabel>
                        }
                    </FluentStack>
                </div>

                <aside class="package-docs-right-rail" aria-label="Outline and symbol tools">
                    <div class="package-docs-toc-col">
                        <TableOfContents Rows="@TocRows" Heading="Table of contents" />
                    </div>

                    <FluentStack Orientation="Orientation.Vertical" Gap="10" Class="package-docs-toolbar">
                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Gap="8" Wrap="true" Class="package-docs-toolbar-search-row">
                            <div class="package-docs-symbol-search-wrap">
                                <FluentTextField @bind-Value="_symbolQuery"
                                                 Label="Search symbols"
                                                 Placeholder="Filter by qualified name, name, or kind…"
                                                 AriaLabel="Filter API symbols" />
                            </div>
                            <div class="package-docs-filter-anchor">
                                <FluentButton Appearance="Appearance.Outline"
                                              Class="package-docs-filter-button"
                                              IconStart="@(new Icons.Regular.Size20.Search())"
                                              Title="Open grouping and filters"
                                              OnClick="ToggleFilterPopover">
                                </FluentButton>
                                @if (_showFilterPopover)
                                {
                                    <FluentCard Class="package-docs-filter-popover">
                                        <FluentStack Orientation="Orientation.Vertical" Gap="10">
                                            <FluentStack Orientation="Orientation.Horizontal"
                                                         VerticalAlignment="VerticalAlignment.Center"
                                                         HorizontalAlignment="HorizontalAlignment.SpaceBetween"
                                                         Gap="8">
                                                <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">Group and filter</FluentLabel>
                                                <FluentButton Appearance="Appearance.Stealth" OnClick="CloseFilterPopover">Close</FluentButton>
                                            </FluentStack>
                                            <FluentSelect TOption="string"
                                                          Value="@_groupBy"
                                                          ValueChanged="SetGroupBy"
                                                          AriaLabel="Group navigation by">
                                                <FluentOption TOption="string" Value="module">Group by module</FluentOption>
                                                <FluentOption TOption="string" Value="kind">Group by kind</FluentOption>
                                            </FluentSelect>
                                            <FluentSelect TOption="string"
                                                          Value="@_moduleFilter"
                                                          ValueChanged="SetModuleFilter"
                                                          AriaLabel="Filter by module">
                                                <FluentOption TOption="string" Value="">All modules</FluentOption>
                                                @foreach (var module in AvailableModules)
                                                {
                                                    <FluentOption TOption="string" Value="@module">@module</FluentOption>
                                                }
                                            </FluentSelect>
                                            <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">Kinds</FluentLabel>
                                            <div class="package-docs-kind-grid">
                                                @foreach (var kind in AvailableKinds)
                                                {
                                                    <label class="package-docs-kind-item">
                                                        <input type="checkbox"
                                                               checked="@IsKindSelected(kind)"
                                                               @onchange="@(() => ToggleKindFilter(kind))" />
                                                        <span>@kind</span>
                                                    </label>
                                                }
                                            </div>
                                            <FluentButton Appearance="Appearance.Outline" OnClick="ClearFilters">Reset filters</FluentButton>
                                        </FluentStack>
                                    </FluentCard>
                                }
                            </div>
                        </FluentStack>

                        <div class="package-docs-symbol-scroll">
                            <PackageDocsSymbolGrid Rows="@SymbolRows" OnSelect="SelectItemAsync" />
                        </div>
                    </FluentStack>
                </aside>
            </div>
        </div>
    }
</div>
