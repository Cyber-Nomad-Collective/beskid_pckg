@inject NavigationManager Navigation
@rendermode InteractiveServer
<FluentProfileMenu TopCorner="true" @bind-Open="@IsOpen" ButtonSize="32px" Initials="@GetInitials()" >
    <HeaderTemplate>
        
    </HeaderTemplate>
    <FooterTemplate>
        
    </FooterTemplate>
    <ChildContent>
        <FluentStack VerticalGap="2"
                     Orientation="Orientation.Vertical"
                     Class="profile-menu-stack"
                     Style="width: 100%; min-width: 11rem; padding: 0.35rem 0.4rem 0.5rem;">
            <FluentMenuItem OnClick="@(() => NavigateTo("/dashboard/profile"))" Class="profile-menu-item">
                <FluentIcon Value="@ProfileIcon" Slot="start" />
                Profile
            </FluentMenuItem>
            <FluentMenuItem OnClick="@(() => NavigateTo("/dashboard/api-keys"))" Class="profile-menu-item">
                <FluentIcon Value="@ApiKeysIcon" Slot="start" />
                API Keys
            </FluentMenuItem>
            <FluentMenuItem OnClick="@(() => NavigateTo("/dashboard/packages/my"))" Class="profile-menu-item">
                <FluentIcon Value="@PackagesIcon" Slot="start" />
                My Packages
            </FluentMenuItem>
            @if (IsSuperAdmin)
            {
                <FluentMenuItem OnClick="@(() => NavigateTo("/dashboard/admin"))" Class="profile-menu-item">
                    <FluentIcon Value="@AdminIcon" Slot="start" />
                    Administration
                </FluentMenuItem>
            }
            <FluentDivider Style="margin: 0.35rem 0;" />
            <FluentMenuItem OnClick="Logout" Class="profile-menu-item">
                <FluentIcon Value="@LogoutIcon" Slot="start" />
                Logout
            </FluentMenuItem>
        </FluentStack>
    </ChildContent>
</FluentProfileMenu>