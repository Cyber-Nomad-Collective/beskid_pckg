@using Microsoft.FluentUI.AspNetCore.Components
@inject NavigationManager Navigation
@rendermode InteractiveServer
<FluentProfileMenu TopCorner="true" @bind-Open="@IsOpen" ButtonSize="32px" Initials="@GetInitials()" >
    <HeaderTemplate>
        
    </HeaderTemplate>
    <FooterTemplate>
        
    </FooterTemplate>
    <ChildContent>
        <FluentStack VerticalGap="5" Orientation="Orientation.Vertical" Style="width: 100%; padding: 0.25rem 0.2rem; margin-top: 0.45rem;">
              <FluentMenuItem OnClick="@(() => NavigateTo("/dashboard/profile"))" Style="width: 100%">
                <FluentIcon Value="@ApiKeysIcon" Slot="start"/>
                Profile
            </FluentMenuItem>
            <FluentMenuItem OnClick="@(() => NavigateTo("/dashboard/api-keys"))" Style="width: 100%">
                <FluentIcon Value="@ApiKeysIcon" Slot="start"/>
                API Keys
            </FluentMenuItem>
            <FluentMenuItem OnClick="@(() => NavigateTo("/dashboard/packages/my"))" Style="width: 100%">
                <FluentIcon Value="@PackagesIcon" Slot="start"/>
                My Packages
            </FluentMenuItem>
            <FluentDivider/>
            <FluentMenuItem OnClick="Logout" Style="width: 100%">
                <FluentIcon Value="@LogoutIcon" Slot="start"/>
                Logout
            </FluentMenuItem>    
        </FluentStack>
    </ChildContent>
</FluentProfileMenu>