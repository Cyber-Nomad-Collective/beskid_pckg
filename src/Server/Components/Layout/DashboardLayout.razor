@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<FluentDesignTheme StorageName="theme" CustomColor="#3aac9e" NeutralBaseColor="#3f5458" />
<FluentMenuProvider/>


<FluentMainLayout Class="dashboard-layout" NavMenuTitle="Navigation menu" >
    <Header>
        <AppTopBar>
            <HeaderStart>
                    <FluentIcon Value="@Icon.FromType<Icons.Regular.Size20.Navigation>()" OnClick="ToggleSidebar" />
            </HeaderStart>
        </AppTopBar>
    </Header>
    <NavMenuContent>
        @if (IsSidebarOpen)
        {
            <aside class="dashboard-sidebar-shell open">
                <FluentNavMenu Width="268" Class="dashboard-navmenu" Title="Publisher navigation">
                    <FluentNavLink Href="/dashboard/profile" Icon="@ProfileIcon">Profile Settings</FluentNavLink>
                    <FluentNavLink Href="/dashboard/api-keys" Icon="@ApiKeysIcon">API Keys</FluentNavLink>
                    <FluentNavGroup Title="Packages" Expanded="true" Icon="@PackagesIcon">
                        <FluentNavLink Href="/dashboard/packages" Icon="@MyPackagesIcon">My Packages</FluentNavLink>
                        <FluentNavLink Href="/dashboard/packages/metadata" Icon="@MetadataIcon">Edit Metadata</FluentNavLink>
                        <FluentNavLink Href="/dashboard/packages/versions" Icon="@VersionsIcon">Versions</FluentNavLink>
                        <FluentNavLink Href="/dashboard/packages/new" Icon="@UploadIcon">Upload Version</FluentNavLink>
                    </FluentNavGroup>

                    <FluentDivider />
                    <FluentNavLink Href="/" Icon="@HomeIcon">Back to Registry</FluentNavLink>
                </FluentNavMenu>
            </aside>
        }
    </NavMenuContent>

    <Body>
        <FluentBodyContent>
            <div class="dashboard-content-area">
                @Body
            </div>
        </FluentBodyContent>
    </Body>
</FluentMainLayout>
<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>