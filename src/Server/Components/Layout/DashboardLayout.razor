@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.FluentUI.AspNetCore.Components.DesignTokens

<FluentDesignTheme StorageName="theme" CustomColor="#3aac9e" NeutralBaseColor="#3f5458" />
<FluentMenuProvider  />


<FluentMainLayout HeaderHeight="64" NavMenuWidth=@SideMenuWidth Class="dashboard-layout"  NavMenuTitle="Navigation menu"  >
    <Header>
        <AppTopBar/>
    </Header>

    <NavMenuContent>
        <FluentNavMenu  Margin="-20" Collapsible="true" Expanded="true" CustomToggle="true"  Width="@SideMenuWidth" Style="padding: 1rem 0.5rem;">       
            <FluentNavLink Href="/dashboard/profile" Icon="@ProfileIcon">Profile Settings</FluentNavLink>
            <FluentNavLink Href="/dashboard/api-keys" Icon="@ApiKeysIcon">API Keys</FluentNavLink>
            <FluentNavGroup Title="Packages" Expanded="true" Icon="@PackagesIcon">
                <FluentNavLink Href="/dashboard/packages" Icon="@MyPackagesIcon">My Packages</FluentNavLink>
                <FluentNavLink Href="/dashboard/packages/versions" Icon="@VersionsIcon">Versions</FluentNavLink>
                <FluentNavLink Href="/dashboard/packages/new" Icon="@UploadIcon">Upload Version</FluentNavLink>
            </FluentNavGroup>
            <FluentDivider/>
        </FluentNavMenu>

    </NavMenuContent>

    <Body>
        <FluentBodyContent Style="padding: 1rem 0.5rem;">
            <div class="dashboard-content-area">
                @Body
            </div>
        </FluentBodyContent>
    </Body>
</FluentMainLayout>
<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>