@inherits LayoutComponentBase
<style>
    .fluent-nav-item.expander {
        display: none;
    }
</style>
<BeskidDesignTheme />

<FluentMainLayout HeaderHeight="64" NavMenuWidth=@SideMenuWidth Class="dashboard-layout" NavMenuTitle="Navigation menu">
    <Header>
        <AppTopBar />
    </Header>
    <NavMenuContent>
        <FluentNavMenu Collapsible="false" Expanded="true" CustomToggle="true" Width="@SideMenuWidth"
                       Style="padding: 1rem 0.5rem;">
            <FluentNavLink Href="/dashboard/profile" Icon="@ProfileIcon">Profile Settings</FluentNavLink>
            <FluentNavLink Href="/dashboard/api-keys" Icon="@ApiKeysIcon">API Keys</FluentNavLink>
            <FluentNavGroup Title="Packages" Expanded="true" Icon="@PackagesIcon">
                <FluentNavLink Href="/dashboard/packages/my" Icon="@MyPackagesIcon">My Packages</FluentNavLink>
            </FluentNavGroup>
            @if (IsSuperAdmin)
            {
                <FluentNavGroup Title="Administration" Expanded="true" Icon="@AdministrationIcon">
                    <FluentNavLink Href="/dashboard/admin" Icon="@AdminOverviewIcon">Overview</FluentNavLink>
                    <FluentNavLink Href="/dashboard/admin/users" Icon="@AdminUsersIcon">Users &amp; roles</FluentNavLink>
                    <FluentNavLink Href="/dashboard/admin/email" Icon="@AdminEmailIcon">Email settings</FluentNavLink>
                    <FluentNavLink Href="/dashboard/admin/registry-activity" Icon="@AdminActivityIcon">Registry activity</FluentNavLink>
                    <FluentNavLink Href="/dashboard/admin/blocked-links" Icon="@AdminShieldIcon">Blocked links</FluentNavLink>
                    <FluentNavLink Href="/dashboard/packages/all" Icon="@AdminPackagesIcon">All packages</FluentNavLink>
                </FluentNavGroup>
            }
            <FluentDivider />
        </FluentNavMenu>

    </NavMenuContent>

    <Body>
        <FluentBodyContent Style="padding: 1rem 0.5rem;">
            <div class="dashboard-content-area">
                @Body
            </div>
            <FluentDialogProvider @rendermode="InteractiveServer" />
        </FluentBodyContent>
    </Body>
</FluentMainLayout>