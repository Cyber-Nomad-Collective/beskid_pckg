<FluentButton Class="notification-icon-button"
              Appearance="Appearance.Stealth"
              OnClick="OnClick"
              Title="@NotificationTitle"
              AriaLabel="@NotificationTitle">
    @if (IsOpen)
    {
        <FluentIcon Value="@(new Icons.Regular.Size20.AlertOff())" />
    }
    else
    {
        <FluentIcon Value="@(new Icons.Regular.Size20.Alert())" />
    }
</FluentButton>

@code {
    [Parameter] public int UnreadCount { get; set; }
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private string NotificationTitle =>
        UnreadCount > 0 ? $"Open notifications ({UnreadCount} unread)" : "Open notifications";
}
