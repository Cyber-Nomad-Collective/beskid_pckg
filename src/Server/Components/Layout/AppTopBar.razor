@inject NavigationManager Navigation

<header class="top-nav">
        <div class="top-nav-left">
            <a class="brand-link" href="@HomeUrl" aria-label="Beskid home">
                <img src="favicon.svg" width="28" height="17" alt="Beskid" />
                <span class="pckg-kicker">Beskid</span>
                <span class="brand">pckg</span>
            </a>
        </div>

        
        <div class="top-nav-right">
                <FluentNavLink Href="@HomeUrl" Match="NavLinkMatch.All">Home</FluentNavLink>
                <FluentNavLink Href="@PackagesUrl">Packages</FluentNavLink>
                <FluentNavLink Href="@ApiDocsUrl">API</FluentNavLink>
            <div class="top-nav-controls">
                <ThemeToggle />

                <AuthorizeView>
                    <Authorized>
                        <NotificationButton UnreadCount="NotificationUnreadCount"
                                            IsOpen="IsNotificationCenterOpen"
                                            OnClick="ToggleNotificationCenter" />
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView>
                    <Authorized Context="authState">
                        <div class="top-nav-user">
                            <UserMenu DisplayName="@(authState.User.Identity?.Name ?? "Account")" @bind-IsOpen="IsOpen" />
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="top-nav-auth">
                            <FluentAnchor Appearance="Appearance.Outline" Href="@LoginUrl">Login</FluentAnchor>
                            <FluentAnchor Appearance="Appearance.Accent" Href="@RegisterUrl">Register</FluentAnchor>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
            <div class="top-nav-hub">
                <BeskidHubLauncher />
            </div>
        </div>
</header>

<AuthorizeView>
    <Authorized>
        <NotificationCenter IsOpen="IsNotificationCenterOpen"
                            OnClose="CloseNotificationCenter"
                            UnreadCountChanged="OnNotificationUnreadCountChanged" />
    </Authorized>
</AuthorizeView>

@code {
    /// <summary>Resolves a path (and optional query) against the app base so links work when PathBase or reverse-proxy path prefixes are used.</summary>
    private string AppUrl(string relativePathAndQuery)
    {
        var baseUri = Navigation.BaseUri;
        if (!baseUri.EndsWith('/'))
            baseUri += "/";
        return new Uri(new Uri(baseUri, UriKind.Absolute), relativePathAndQuery).AbsoluteUri;
    }

    private string HomeUrl => Navigation.BaseUri;
    private string PackagesUrl => AppUrl("packages");
    private string ApiDocsUrl => AppUrl("scalar");
    private string LoginUrl => AppUrl("auth?mode=login");
    private string RegisterUrl => AppUrl("auth?mode=register");
}