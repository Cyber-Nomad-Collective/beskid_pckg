@using Microsoft.AspNetCore.Components.Authorization

<header class="top-nav">
    <div class="top-nav-left">
        <img src="favicon.svg" width="28" height="17" alt="Beskid" />
        <span class="brand">Beskid Package Registry</span>

        @if (HeaderStart != null)
        {
            @HeaderStart
        }
    </div>
    <div class="top-nav-right">

        <nav class="top-nav-links" aria-label="Primary">
            <NavLink href="/" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink href="/packages">Packages</NavLink>
            <AuthorizeView>
                <Authorized>
                    <NavLink href="/dashboard/packages">Dashboard</NavLink>
                </Authorized>
            </AuthorizeView>
            <a href="/scalar">API</a>
        </nav>
        <FluentStack Orientation="Orientation.Horizontal" Gap="12px" VerticalAlignment="VerticalAlignment.Center">
            <ThemeToggle />

            <AuthorizeView>
                <Authorized Context="authState">
                    <FluentStack Orientation="Orientation.Horizontal" Gap="8px" VerticalAlignment="VerticalAlignment.Center">
                        <span class="user-display-name">@(authState.User.Identity?.Name ?? "Account")</span>
                        <UserMenu DisplayName="@(authState.User.Identity?.Name ?? "Account")" />
                    </FluentStack>
                </Authorized>
                <NotAuthorized>
                    <FluentStack Orientation="Orientation.Horizontal" Gap="8px">
                        <FluentAnchor Appearance="Appearance.Outline" Href="/auth?mode=login">Login</FluentAnchor>
                        <FluentAnchor Appearance="Appearance.Accent" Href="/auth?mode=register">Register</FluentAnchor>
                    </FluentStack>
                </NotAuthorized>
            </AuthorizeView>
        </FluentStack>
    </div>
</header>