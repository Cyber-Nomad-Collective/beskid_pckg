@using Microsoft.AspNetCore.Components.Authorization

<header class="top-nav">
        <div class="top-nav-left">
            @if (HeaderStart != null)
            {
                @HeaderStart
            }

            <a class="brand-link" href="/" aria-label="Beskid home">
                <img src="favicon.svg" width="28" height="17" alt="Beskid" />
                <span class="brand">beskid pckg</span>
            </a>
        </div>

        
        <div class="top-nav-right">
                <FluentNavLink href="/" Match="NavLinkMatch.All">Home</FluentNavLink>
                <FluentNavLink href="/packages">Packages</FluentNavLink>
                <FluentNavLink href="/scalar">API</FluentNavLink>
            <div class="top-nav-controls">
                <ThemeToggle />

                <AuthorizeView>
                    <Authorized>
                        <NotificationButton UnreadCount="NotificationUnreadCount"
                                            IsOpen="IsNotificationCenterOpen"
                                            OnClick="ToggleNotificationCenter" />
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView>
                    <Authorized Context="authState">
                        <div class="top-nav-user">
                            <UserMenu DisplayName="@(authState.User.Identity?.Name ?? "Account")" @bind-IsOpen="IsOpen" />
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="top-nav-auth">
                            <FluentAnchor Appearance="Appearance.Outline" Href="/auth?mode=login">Login</FluentAnchor>
                            <FluentAnchor Appearance="Appearance.Accent" Href="/auth?mode=register">Register</FluentAnchor>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>
</header>

<AuthorizeView>
    <Authorized>
        <NotificationCenter IsOpen="IsNotificationCenterOpen"
                            OnClose="CloseNotificationCenter"
                            UnreadCountChanged="OnNotificationUnreadCountChanged" />
    </Authorized>
</AuthorizeView>