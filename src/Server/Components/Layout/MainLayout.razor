@inherits LayoutComponentBase
@inject NavigationManager Navigation
<FluentDesignTheme StorageName="theme" CustomColor="#3aac9e" NeutralBaseColor="#3f5458"/>
<FluentMenuProvider/>
<FluentMainLayout>
    <Header>
        <AppTopBar/>
    </Header>
    <Body>
    <FluentBodyContent>
        @Body
    </FluentBodyContent>
    </Body>
</FluentMainLayout>
<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
