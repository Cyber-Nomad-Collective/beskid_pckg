@inherits LayoutComponentBase
@inject NavigationManager Navigation
<FluentDesignTheme StorageName="theme" CustomColor="#3aac9e" NeutralBaseColor="#3f5458"/>
<FluentMenuProvider/>

<FluentMainLayout HeaderHeight="64" Class="dashboard-layout"  NavMenuTitle="Navigation menu"  >
    <Header>
        <AppTopBar/>
    </Header>
    <Body>
    <FluentBodyContent Style="padding: 1.5rem 1rem;">
        @Body
    </FluentBodyContent>
    </Body>
   
</FluentMainLayout>
<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
