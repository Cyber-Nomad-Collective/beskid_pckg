<div class="source-preview-surface">
    @if (IsLoading)
    {
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Gap="10">
            <FluentProgressRing />
            <FluentLabel Typo="Typography.Body">Loading preview…</FluentLabel>
        </FluentStack>
    }
    else if (!string.IsNullOrWhiteSpace(Error))
    {
        <FluentMessageBar Intent="MessageIntent.Warning">@Error</FluentMessageBar>
    }
    else if (PreviewKind == "image" && !string.IsNullOrWhiteSpace(ImageUrl))
    {
        <div class="source-image-preview">
            <img src="@ImageUrl" alt="@SelectedPath" />
        </div>
    }
    else if (PreviewKind == "text")
    {
        <PackageReadonlyCodeEditor Value="@TextContent"
                                   Language="@MonacoLanguage"
                                   LayoutGeneration="@LayoutGeneration" />
    }
    else
    {
        <FluentMessageBar Intent="MessageIntent.Info">
            Binary file preview is not available. Download or inspect this file locally.
        </FluentMessageBar>
    }
</div>

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public string PreviewKind { get; set; } = "none";
    [Parameter] public string TextContent { get; set; } = string.Empty;
    [Parameter] public string MonacoLanguage { get; set; } = "plaintext";
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string? SelectedPath { get; set; }

    [Parameter] public int LayoutGeneration { get; set; }
}
