@using Microsoft.AspNetCore.Components.Authorization
@using Server.Data

<div class="board-container">
    <header class="board-header">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Wrap="true">
                <FluentStack Orientation="Orientation.Vertical" Style="flex: 1;">
                    <h3 style="margin: 0;">@BoardName</h3>
                    @if (!string.IsNullOrWhiteSpace(BoardDescription))
                    {
                        <p class="muted" style="margin: 0;">@BoardDescription</p>
                    }
                </FluentStack>
                <AuthorizeView>
                    <Authorized>
                        @if (CanModerateBoard)
                        {
                            <FluentButton Appearance="Appearance.Outline"
                                          OnClick="ToggleBoardLockAsync"
                                          Title="@(IsLocked ? "Allow new threads and comments" : "Prevent new threads")">
                                @(IsLocked ? "Unlock board" : "Lock board")
                            </FluentButton>
                        }
                        @if (!IsLocked)
                        {
                            <FluentButton Appearance="Appearance.Accent" OnClick="OpenComposer" IconStart="@(new Icons.Regular.Size20.Add())">
                                @NewPostButtonText
                            </FluentButton>
                        }
                    </Authorized>
                </AuthorizeView>
            </FluentStack>
    </header>

    @if (IsComposerOpen)
    {
        <FluentCard Class="board-composer-card">
            <FluentStack Orientation="Orientation.Vertical" Gap="20px" Class="composer-inner">
                <div class="composer-header">
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Gap="12px" Wrap="true" Class="composer-header-row">
                        <div class="composer-header-titles">
                            <h4 class="composer-title">Create new thread</h4>
                            <p class="composer-subtitle muted">Describe a problem, a feature you need, or an improvement idea.</p>
                        </div>
                        <FluentBadge Appearance="Appearance.Neutral" Class="composer-tracker-badge">Issue tracker</FluentBadge>
                        <span class="composer-header-spacer"></span>
                        <FluentButton Appearance="Appearance.Stealth" IconStart="@(new Icons.Regular.Size20.ArrowLeft())" OnClick="CancelComposer" Class="composer-back-btn">
                            Back to threads
                        </FluentButton>
                    </FluentStack>
                </div>

                @if (ShowPostTypeSelector && FilterPostType is null)
                {
                    <div class="composer-section">
                        <label class="fluent-label" id="composer-post-type-label">Thread type</label>
                        <p class="composer-field-hint">Choose the category that best matches your post.</p>
                        <div class="post-type-tiles" role="group" aria-labelledby="composer-post-type-label">
                            <button type="button"
                                    class="post-type-tile @(NewPostType == BoardPostType.Issue ? "selected" : "")"
                                    style="--post-type-accent: @GetPostTypeColor(BoardPostType.Issue);"
                                    @onclick="@(() => NewPostType = BoardPostType.Issue)">
                                <span class="post-type-tile-icon" aria-hidden="true">
                                    @if (NewPostType == BoardPostType.Issue)
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size24.ErrorCircle())" Color="Color.Custom" CustomColor="@GetPostTypeColor(BoardPostType.Issue)" />
                                    }
                                    else
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size24.ErrorCircle())" Color="Color.Neutral" />
                                    }
                                </span>
                                <span class="post-type-tile-text">
                                    <span class="post-type-tile-label">Issue</span>
                                    <span class="post-type-tile-desc">Bug or something broken</span>
                                </span>
                            </button>
                            <button type="button"
                                    class="post-type-tile @(NewPostType == BoardPostType.FeatureRequest ? "selected" : "")"
                                    style="--post-type-accent: @GetPostTypeColor(BoardPostType.FeatureRequest);"
                                    @onclick="@(() => NewPostType = BoardPostType.FeatureRequest)">
                                <span class="post-type-tile-icon" aria-hidden="true">
                                    @if (NewPostType == BoardPostType.FeatureRequest)
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size24.Rocket())" Color="Color.Custom" CustomColor="@GetPostTypeColor(BoardPostType.FeatureRequest)" />
                                    }
                                    else
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size24.Rocket())" Color="Color.Neutral" />
                                    }
                                </span>
                                <span class="post-type-tile-text">
                                    <span class="post-type-tile-label">Feature</span>
                                    <span class="post-type-tile-desc">New capability</span>
                                </span>
                            </button>
                            <button type="button"
                                    class="post-type-tile @(NewPostType == BoardPostType.Suggestion ? "selected" : "")"
                                    style="--post-type-accent: @GetPostTypeColor(BoardPostType.Suggestion);"
                                    @onclick="@(() => NewPostType = BoardPostType.Suggestion)">
                                <span class="post-type-tile-icon" aria-hidden="true">
                                    @if (NewPostType == BoardPostType.Suggestion)
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size24.LightbulbFilament())" Color="Color.Custom" CustomColor="@GetPostTypeColor(BoardPostType.Suggestion)" />
                                    }
                                    else
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size24.LightbulbFilament())" Color="Color.Neutral" />
                                    }
                                </span>
                                <span class="post-type-tile-text">
                                    <span class="post-type-tile-label">Suggestion</span>
                                    <span class="post-type-tile-desc">Idea or tweak</span>
                                </span>
                            </button>
                        </div>
                    </div>
                }

                <div class="composer-section">
                    <FluentTextField @bind-Value="NewPostTitle"
                                     Label="Title"
                                     Placeholder="Short, specific title"
                                     Style="width: 100%;" />
                </div>

                <div class="composer-section">
                    <label class="fluent-label">Tags</label>
                    <p class="composer-field-hint">Optional keywords so others can find this thread.</p>
                    <div class="composer-tags-row">
                        <FluentTextField @bind-Value="NewTagInput" Placeholder="e.g. bug, docs, performance" Class="composer-tag-input" />
                        <FluentButton Appearance="Appearance.Outline" OnClick="AddTag" Disabled="@string.IsNullOrWhiteSpace(NewTagInput)">Add tag</FluentButton>
                    </div>
                    @if (NewPostTags.Count > 0)
                    {
                        <FluentStack Orientation="Orientation.Horizontal" Gap="8px" Wrap="true" Style="margin-top: 10px;">
                            @foreach (var tag in NewPostTags)
                            {
                                <FluentBadge Appearance="Appearance.Neutral" Class="composer-tag-chip">
                                    #@tag
                                    <FluentButton Appearance="Appearance.Stealth" Class="composer-tag-remove" OnClick="@(() => RemoveTag(tag))" Title="Remove tag">
                                        <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" />
                                    </FluentButton>
                                </FluentBadge>
                            }
                        </FluentStack>
                    }
                </div>

                <div class="composer-section composer-section-body">
                    <ThemedRichTextEditor Class="composer-rich-text"
                                          Label="Main content"
                                          Placeholder="Describe the issue or idea clearly. Include context, expected behavior, and steps if relevant."
                                          HintText="Use headings, lists, code blocks, and links. Select text to format."
                                          @ref="ComposerEditor"
                                          @bind-Value="NewPostContent" />
                </div>

                <div class="composer-section">
                    <UploadDropzone Label="Attachment"
                                    PrimaryText="Choose file"
                                    SecondaryText="Optional attachment"
                                    HintText="Drop files here or click to browse"
                                    AriaLabel="Choose attachment" />
                </div>

                @if (!string.IsNullOrWhiteSpace(CaptchaSiteKey))
                {
                    <div class="composer-section">
                        <label class="fluent-label">Verification</label>
                        <TurnstileCaptcha SiteKey="@CaptchaSiteKey" @bind-Token="PostCaptchaToken" />
                    </div>
                }

                <FluentStack Orientation="Orientation.Horizontal" Gap="10px" Class="composer-actions" Wrap="true">
                    <FluentButton Appearance="Appearance.Accent" OnClick="CreatePostAsync" Disabled="@(string.IsNullOrWhiteSpace(NewPostTitle) || IsSubmittingPost)">
                        <FluentIcon Value="@(new Icons.Regular.Size20.Send())" Style="margin-right: 6px;" />
                        @(IsSubmittingPost ? "Posting..." : "Post thread")
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Outline" OnClick="CancelComposer" Disabled="IsSubmittingPost">Cancel</FluentButton>
                </FluentStack>
            </FluentStack>
        </FluentCard>
    }
    else if (IsLoading)
    {
        <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" Style="padding: 48px;">
            <FluentProgressRing />
            <span class="muted">Loading posts...</span>
        </FluentStack>
    }
    else if (Posts.Count == 0)
    {
        <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" Style="padding: 48px;">
            <FluentIcon Value="@(new Icons.Regular.Size48.Chat())" Color="Color.Neutral"/>
            <p class="muted" style="text-align: center;">@EmptyStateText</p>
        </FluentStack>
    }
    else
    {
        <FluentStack Orientation="Orientation.Vertical" Gap="12px" Class="board-posts-list">
            @foreach (var post in Posts)
            {
                <FluentCard Class="@($"board-post-card {(post.IsPinned ? "pinned" : "")}")" @onclick="@(() => ViewPost(post.Id))">
                    <FluentStack Orientation="Orientation.Vertical" Gap="12px">
                        <FluentStack Orientation="Orientation.Horizontal" Gap="8px" VerticalAlignment="VerticalAlignment.Center" Wrap="true">
                            <span class="post-type-badge" style="background-color: @GetPostTypeColor(post.PostType);">
                                @GetPostTypeLabel(post.PostType)
                            </span>
                            @if (post.IsPinned)
                            {
                                <FluentBadge Appearance="Appearance.Accent">
                                    <FluentIcon Value="@(new Icons.Regular.Size16.Pin())" Style="margin-right: 4px;" /> Pinned
                                </FluentBadge>
                            }
                            <span style="flex: 1;"></span>
                            <span class="muted post-date">@post.CreatedAtUtc.ToString("MMM d, yyyy")</span>
                        </FluentStack>
                        <h4 class="post-title">@post.Title</h4>
                        <div class="post-content">@RenderContentPreview(post.Content)</div>
                        <FluentStack Orientation="Orientation.Horizontal" Gap="16px" VerticalAlignment="VerticalAlignment.Center" Class="post-actions">
                            <FluentStack Orientation="Orientation.Horizontal" Gap="4px" VerticalAlignment="VerticalAlignment.Center" Class="vote-buttons">
                                <FluentButton Appearance="@(post.CurrentUserVote == 1 ? Appearance.Accent : Appearance.Stealth)"
                                              OnClick="@(() => VotePost(post.Id, 1))"
                                              OnClick:stopPropagation="true"
                                              Title="Upvote"
                                              Class="@($"vote-btn {(post.CurrentUserVote == 1 ? "voted-up" : "")}")">
                                    @if (post.CurrentUserVote == 1)
                                    {
                                        <FluentIcon Value="@(new Icons.Filled.Size20.ArrowUp())" Color="Color.Custom" CustomColor="#ff4500" />
                                    }
                                    else
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size20.ArrowUp())" Color="Color.Neutral" />
                                    }
                                    <span class="@(post.CurrentUserVote == 1 ? "vote-count-active upvote" : "")">@post.UpvoteCount</span>
                                </FluentButton>
                                <FluentButton Appearance="@(post.CurrentUserVote == -1 ? Appearance.Accent : Appearance.Stealth)"
                                              OnClick="@(() => VotePost(post.Id, -1))"
                                              OnClick:stopPropagation="true"
                                              Title="Downvote"
                                              Class="@($"vote-btn {(post.CurrentUserVote == -1 ? "voted-down" : "")}")">
                                    @if (post.CurrentUserVote == -1)
                                    {
                                        <FluentIcon Value="@(new Icons.Filled.Size20.ArrowDown())" Color="Color.Custom" CustomColor="#7193ff" />
                                    }
                                    else
                                    {
                                        <FluentIcon Value="@(new Icons.Regular.Size20.ArrowDown())" Color="Color.Neutral" />
                                    }
                                    <span class="@(post.CurrentUserVote == -1 ? "vote-count-active downvote" : "")">@post.DownvoteCount</span>
                                </FluentButton>
                            </FluentStack>
                            <FluentButton Appearance="Appearance.Stealth" OnClick="@(() => ViewPost(post.Id))" OnClick:stopPropagation="true">
                                <FluentIcon Value="@(new Icons.Regular.Size20.Comment())" Style="margin-right: 6px;" />
                                @ViewDiscussionButtonText
                            </FluentButton>
                        </FluentStack>
                    </FluentStack>
                </FluentCard>
            }
        </FluentStack>

        @if (TotalPages > 1)
        {
            <FluentStack Orientation="Orientation.Horizontal" Gap="12px" Style="margin-top: 24px; padding: 16px; background: var(--neutral-fill-stealth-rest); border-radius: 8px;" VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="HorizontalAlignment.Center">
                <FluentButton Appearance="Appearance.Stealth" Disabled="@(CurrentPage <= 1)" OnClick="PreviousPageAsync">
                    <FluentIcon Value="@(new Icons.Regular.Size20.ChevronLeft())" Style="margin-right: 4px;" />
                    Previous
                </FluentButton>
                <FluentStack Orientation="Orientation.Horizontal" Gap="8px" VerticalAlignment="VerticalAlignment.Center">
                    @for (var i = 1; i <= TotalPages; i++)
                    {
                        var page = i;
                        @if (i == CurrentPage)
                        {
                            <FluentBadge Appearance="Appearance.Accent">@i</FluentBadge>
                        }
                        else if (i == 1 || i == TotalPages || (i >= CurrentPage - 1 && i <= CurrentPage + 1))
                        {
                            <FluentButton Appearance="Appearance.Stealth" OnClick="@(() => GoToPageAsync(page))">@i</FluentButton>
                        }
                        else if (i == CurrentPage - 2 || i == CurrentPage + 2)
                        {
                            <span class="muted">...</span>
                        }
                    }
                </FluentStack>
                <FluentButton Appearance="Appearance.Stealth" Disabled="@(CurrentPage >= TotalPages)" OnClick="NextPageAsync">
                    Next
                    <FluentIcon Value="@(new Icons.Regular.Size20.ChevronRight())" Style="margin-left: 4px;" />
                </FluentButton>
            </FluentStack>
        }
    }
</div>
