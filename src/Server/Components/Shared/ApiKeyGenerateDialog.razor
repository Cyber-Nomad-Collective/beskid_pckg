@using Microsoft.FluentUI.AspNetCore.Components

<FluentDialogHeader ShowDismiss="false">
    <FluentLabel Typo="Typography.PaneHeader">Generate API key</FluentLabel>
</FluentDialogHeader>
<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical" Gap="16px" Class="app-dialog-stack">
        <p class="muted app-dialog-intro">Create a key for CLI publishing and read operations.</p>

        <FluentTextField @bind-Value="Content.Name" Label="Key name" Placeholder="CI publish token" Required />
        <FluentCard Class="app-dialog-surface">
            <FluentStack Orientation="Orientation.Vertical" Gap="8px">
                <FluentLabel>Scopes</FluentLabel>
                <FluentCheckbox @bind-Value="Content.PublishScope">Publish</FluentCheckbox>
                <FluentCheckbox @bind-Value="Content.ReadScope">Read</FluentCheckbox>
            </FluentStack>
        </FluentCard>
    </FluentStack>
</FluentDialogBody>
<FluentDialogFooter>
    <FluentButton Appearance="Appearance.Outline" OnClick="CancelAsync">Cancel</FluentButton>
    <FluentButton Appearance="Appearance.Accent" OnClick="SubmitAsync">Generate key</FluentButton>
</FluentDialogFooter>
