<FluentDialogHeader ShowDismiss="false">
    <FluentLabel Typo="Typography.PaneHeader">Upload Version</FluentLabel>
</FluentDialogHeader>
<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical" Gap="16px" Class="app-dialog-stack">
        <p class="muted app-dialog-intro">Upload a .bpkg artifact and publish a new immutable version.</p>

        <div class="app-dialog-grid-two">
            <FluentTextField @bind-Value="Content.PackageName" Label="Package name" Placeholder="my.package" Required Disabled="@Content.IsPackageLocked" />
            <FluentTextField @bind-Value="Content.Version" Label="Version" Placeholder="1.0.0" Required />
        </div>

        <FluentTextField @bind-Value="Content.ChecksumSha256" Label="Checksum SHA-256 (optional)" Placeholder="Paste checksum to enforce integrity" />

        <FluentCard Class="app-dialog-surface">
            <UploadDropzone Label="Artifact (.bpkg)"
                            PrimaryText="Choose artifact"
                            SecondaryText="Only .bpkg package archives"
                            HintText="Max size: 64 MB. Drop file here or click to browse"
                            AriaLabel="Choose package artifact"
                            Accept=".bpk,.bpkg,application/zip"
                            OnFilesSelected="HandleArtifactSelected" />
        </FluentCard>
    </FluentStack>
</FluentDialogBody>
<FluentDialogFooter>
    <FluentButton Appearance="Appearance.Outline" OnClick="CancelAsync">Cancel</FluentButton>
    <FluentButton Appearance="Appearance.Accent" OnClick="SubmitAsync">Upload & Publish</FluentButton>
</FluentDialogFooter>
