@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

<div class="@RootClass(Variant)">
    <FluentStack Orientation="Orientation.Vertical" Gap="12">
        @if (_loadingIndex)
        {
            <FluentCard Class="docs-state-card">
                <FluentStack Orientation="Orientation.Horizontal"
                             VerticalAlignment="VerticalAlignment.Center"
                             Gap="12"
                             Wrap="true">
                    <FluentProgressRing />
                    <FluentLabel Typo="Typography.Body">Loading documentation…</FluentLabel>
                </FluentStack>
            </FluentCard>
        }
        else if (_loadError is not null)
        {
            <FluentCard Class="docs-state-card">
                <FluentStack Orientation="Orientation.Vertical" Gap="10">
                    <FluentMessageBar Intent="MessageIntent.Warning">@_loadError</FluentMessageBar>
                    <FluentLabel Typo="Typography.Body" Class="muted">
                        Authors can add Markdown under <code>docs/</code> in the package source before publishing, or include a root <code>README.md</code>.
                    </FluentLabel>
                </FluentStack>
            </FluentCard>
        }
        else
        {
            <FluentCard Class="docs-browser-shell-card">
                <FluentStack Orientation="Orientation.Vertical" Gap="14" Class="docs-browser-card-inner">
                    <FluentStack Orientation="Orientation.Horizontal"
                                 VerticalAlignment="VerticalAlignment.Center"
                                 Wrap="true"
                                 Gap="10"
                                 Class="docs-browser-toolbar-row">
                        <FluentTextField @bind-Value="_search"
                                         Placeholder="Filter by title or path…"
                                         AriaLabel="Filter documentation pages"
                                         IconStart="@(new Icons.Regular.Size20.Search())"
                                         Style="flex: 1; min-width: 12rem; max-width: 22rem;" />
                        <FluentBadge Appearance="Appearance.Neutral">@_allFiles.Count page(s)</FluentBadge>
                    </FluentStack>

                    <FluentStack Orientation="Orientation.Horizontal"
                                 Gap="16"
                                 Wrap="true"
                                 Class="docs-browser-split-stack">
                        <FluentCard Class="docs-nav-card">
                            <FluentStack Orientation="Orientation.Vertical" Gap="8">
                                <FluentLabel Typo="Typography.Body" Weight="FontWeight.Bold">Topics</FluentLabel>
                                @if (!FilteredFiles.Any())
                                {
                                    <FluentLabel Typo="Typography.Body" Class="muted">No pages match your filter.</FluentLabel>
                                }
                                else
                                {
                                    <FluentStack Orientation="Orientation.Vertical" Gap="4" Class="docs-nav-list">
                                        @foreach (var file in FilteredFiles)
                                        {
                                            var isActive = string.Equals(file.Path, _selectedPath, StringComparison.Ordinal);
                                            <FluentButton Appearance="@(isActive ? Appearance.Accent : Appearance.Stealth)"
                                                          Class="docs-file-link"
                                                          Title="@file.Path"
                                                          OnClick="@(() => SelectPathAsync(file.Path))">
                                                @file.Title
                                            </FluentButton>
                                        }
                                    </FluentStack>
                                }
                            </FluentStack>
                        </FluentCard>

                        <FluentCard Class="docs-article-card">
                            <FluentStack Orientation="Orientation.Vertical" Gap="12">
                                @if (!string.IsNullOrWhiteSpace(_selectedTitle))
                                {
                                    <FluentStack Orientation="Orientation.Horizontal"
                                                 VerticalAlignment="VerticalAlignment.Center"
                                                 Wrap="true"
                                                 Gap="8"
                                                 Class="docs-article-head">
                                        <FluentLabel Typo="Typography.PaneHeader" Class="docs-article-title">@_selectedTitle</FluentLabel>
                                        @if (!string.IsNullOrWhiteSpace(_selectedPath))
                                        {
                                            <FluentBadge Appearance="Appearance.Lightweight" Title="@_selectedPath">@ShortPath(_selectedPath)</FluentBadge>
                                        }
                                    </FluentStack>
                                }

                                @if (_loadingDoc)
                                {
                                    <FluentStack Orientation="Orientation.Horizontal"
                                                 VerticalAlignment="VerticalAlignment.Center"
                                                 Gap="10">
                                        <FluentProgressRing />
                                        <FluentLabel Typo="Typography.Body" Class="muted">Rendering…</FluentLabel>
                                    </FluentStack>
                                }
                                else
                                {
                                    <div class="docs-markdown-body">
                                        @_renderedDoc
                                    </div>
                                }
                            </FluentStack>
                        </FluentCard>
                    </FluentStack>
                </FluentStack>
            </FluentCard>
        }
    </FluentStack>
</div>
