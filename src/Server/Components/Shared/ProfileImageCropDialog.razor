<FluentDialogHeader ShowDismiss="false">
    <FluentLabel Typo="Typography.PaneHeader">Crop profile photo</FluentLabel>
</FluentDialogHeader>
<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical" Gap="12px" Class="app-dialog-stack">
        <p class="muted app-dialog-intro">Adjust crop area before uploading. Output is a square PNG.</p>

        @if (!string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <FluentMessageBar Intent="MessageIntent.Error">@ErrorMessage</FluentMessageBar>
        }

        @if (string.IsNullOrWhiteSpace(SourceDataUrl))
        {
            <FluentProgressRing Style="width: 28px; height: 28px;" />
        }
        else
        {
            <FluentCard Class="app-dialog-surface">
                <div class="profile-crop-preview">
                    <img @ref="CropImageElement"
                         class="profile-crop-image"
                         src="@SourceDataUrl"
                         alt="Profile image crop preview" />
                </div>
            </FluentCard>
        }
    </FluentStack>
</FluentDialogBody>
<FluentDialogFooter>
    <FluentButton Appearance="Appearance.Outline" OnClick="CancelAsync" Disabled="@IsBusy">Cancel</FluentButton>
    <FluentButton Appearance="Appearance.Accent" OnClick="SubmitAsync" Disabled="@(IsBusy || string.IsNullOrWhiteSpace(SourceDataUrl))">
        @(IsBusy ? "Cropping..." : "Use this crop")
    </FluentButton>
</FluentDialogFooter>

<style>
    .profile-crop-preview {
        width: min(100%, 340px);
        aspect-ratio: 1;
        margin: 0 auto;
        border-radius: 12px;
        border: 1px solid var(--neutral-stroke-rest);
        background-color: var(--neutral-layer-2);
        overflow: hidden;
    }

    .profile-crop-image {
        display: block;
        width: 100%;
        max-width: 100%;
        transition: transform 0.15s ease;
        will-change: transform;
    }
</style>
