@if (Actions is { Count: > 0 })
{
    <div class="grid-action-overflow @Class">
        
        @if (Actions.Count == 1)
        {
            var action = Actions[0];
            <GridActionButton Icon="@action.Icon"
                              Tooltip="@action.Tooltip"
                              Appearance="@action.Appearance"
                              Disabled="@action.Disabled"
                              OnClick="@action.OnClick"/>
        }
        else
        {
            <FluentMenu @bind-Open="_menuOpen"
                        Anchor="@_menuButtonId"
                        Anchored="true"
                        UseMenuService="true"
                        Trigger="MouseButton.Left"
                        VerticalPosition="VerticalPosition.Bottom"
                        HorizontalViewportLock="true"
                        VerticalInset="true">
                @foreach (var action in Actions)
                {
                    <FluentMenuItem Disabled="@action.Disabled"
                                    OnClick="@(() => InvokeFromMenuAsync(action))">
                        <span slot="start">
                            <FluentIcon Value="@action.Icon" Color="Color.Neutral"/>
                        </span>
                        @action.Tooltip
                    </FluentMenuItem>
                }
            </FluentMenu>
        }
    </div>
}
