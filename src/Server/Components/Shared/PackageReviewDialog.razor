@using Microsoft.FluentUI.AspNetCore.Components

<FluentDialogHeader ShowDismiss="false">
    <FluentLabel Typo="Typography.PaneHeader">Write a Review</FluentLabel>
</FluentDialogHeader>

<FluentDialogBody>
    <FluentStack Orientation="Orientation.Vertical" Gap="14px" Class="review-dialog-stack">
        <p class="muted">Share your experience with <strong>@Content.PackageName</strong>.</p>

        <div class="review-rating-block">
            <FluentLabel>Rating</FluentLabel>
            <FluentRatingPicker Value="Content.Rating" ValueChanged="OnRatingChanged" />
        </div>

        <FluentTextArea Label="Review"
                        Placeholder="What worked well? What should improve?"
                        Resize="TextAreaResize.Vertical"
                        Rows="7"
                        @bind-Value="Content.Comment" />
        <small class="muted">Formatting is sanitized on save for safe display.</small>
    </FluentStack>
</FluentDialogBody>

<FluentDialogFooter>
    <FluentButton Appearance="Appearance.Outline" OnClick="CancelAsync">Cancel</FluentButton>
    <FluentButton Appearance="Appearance.Accent" OnClick="SubmitAsync">Post review</FluentButton>
</FluentDialogFooter>
