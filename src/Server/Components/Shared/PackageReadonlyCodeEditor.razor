@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="source-editor-shell" @ref="_shellRef">
    <StandaloneCodeEditor @key="_editorKey"
                          Id="@EditorId"
                          ConstructionOptions="BuildOptions" />
</div>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string Language { get; set; } = "plaintext";
    [Parameter] public string EditorId { get; set; } = "pkg-src-editor";
    /// <summary>Increment when the editor container becomes visible (e.g. Source tab selected) to force Monaco layout.</summary>
    [Parameter] public int LayoutGeneration { get; set; }

    private string _editorKey = string.Empty;
    private ElementReference _shellRef;
    private IJSObjectReference? _layoutModule;
    private int _attachedLayoutGeneration = -1;

    private StandaloneEditorConstructionOptions BuildOptions(StandaloneCodeEditor _)
        => new()
        {
            AutomaticLayout = true,
            ReadOnly = true,
            WordWrap = "on",
            Minimap = new EditorMinimapOptions { Enabled = false },
            ScrollBeyondLastLine = false,
            FontSize = 13,
            Language = NormalizeLanguage(Language),
            Value = Value ?? string.Empty
        };

    protected override void OnParametersSet()
    {
        _editorKey = $"{NormalizeLanguage(Language)}::{Value?.GetHashCode() ?? 0}::{EditorId}";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender && LayoutGeneration == _attachedLayoutGeneration)
        {
            return;
        }

        _attachedLayoutGeneration = LayoutGeneration;
        _layoutModule ??= await JS.InvokeAsync<IJSObjectReference>(
            "import",
            "./package-readonly-editor.js");

        try
        {
            await _layoutModule.InvokeVoidAsync("attach", _shellRef, EditorId);
            // Monaco mounts asynchronously after Blazor render; relayout once it is ready.
            await Task.Delay(50);
            await _layoutModule.InvokeVoidAsync("layoutNow", _shellRef, EditorId);
        }
        catch (JSDisconnectedException)
        {
            // Circuit gone during navigation.
        }
        catch (JSException)
        {
            // Host not measurable yet; ResizeObserver will retry.
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_layoutModule is not null)
        {
            try
            {
                await _layoutModule.InvokeVoidAsync("dispose", _shellRef);
            }
            catch (JSDisconnectedException)
            {
            }

            await _layoutModule.DisposeAsync();
        }
    }

    private static string NormalizeLanguage(string? language)
        => string.IsNullOrWhiteSpace(language) ? "plaintext" : language.Trim().ToLowerInvariant();
}
