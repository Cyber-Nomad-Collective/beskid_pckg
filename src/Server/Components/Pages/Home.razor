@page "/"
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Caching.Memory
@using pckg.Data
@rendermode InteractiveServer

@inject ApplicationDbContext DbContext
@inject IMemoryCache Cache

<PageTitle>Beskid Registry</PageTitle>


<FluentGrid Spacing="3">
    <FluentGridItem xs="12">
        <section class="hero">
            <h1>Package paradise for developers and consumers</h1>
            <p>Discover, evaluate, and publish Beskid packages in one unified workspace.</p>
        </section>
    </FluentGridItem>

    <FluentGridItem xs="12" sm="6" md="3">
        <FluentCard Class="section-card">
            <h3>Total packages</h3>
            <FluentBadge Appearance="@Appearance.Accent">@TotalPackages</FluentBadge>
        </FluentCard>
    </FluentGridItem>

    <FluentGridItem xs="12" sm="6" md="3">
        <FluentCard Class="section-card">
            <h3>Total downloads</h3>
            <FluentBadge Appearance="@Appearance.Neutral">@TotalDownloads</FluentBadge>
        </FluentCard>
    </FluentGridItem>

    <FluentGridItem xs="12" sm="6" md="3">
        <FluentCard Class="section-card">
            <h3>Publishers</h3>
            <FluentBadge Appearance="@Appearance.Neutral">@TotalPublishers</FluentBadge>
        </FluentCard>
    </FluentGridItem>

    <FluentGridItem xs="12" sm="6" md="3">
        <FluentCard Class="section-card">
            <h3>Pending reviews</h3>
            <FluentBadge Appearance="@Appearance.Neutral">@PendingReviews</FluentBadge>
        </FluentCard>
    </FluentGridItem>

    <FluentGridItem xs="12" md="6">
        <FluentCard Class="section-card">
            <h2>Top categories</h2>
            @if (TopCategories.Count == 0)
            {
                <p>No packages yet.</p>
            }
            else
            {
                <ul>
                    @foreach (var row in TopCategories)
                    {
                        <li><strong>@row.Category</strong> - @row.Count packages</li>
                    }
                </ul>
            }
        </FluentCard>
    </FluentGridItem>

    <FluentGridItem xs="12" md="6">
        <FluentCard Class="section-card">
            <h2>Trending packages</h2>
            @if (TrendingPackages.Count == 0)
            {
                <p>No public packages yet.</p>
            }
            else
            {
                <ul>
                    @foreach (var pkg in TrendingPackages)
                    {
                        <li>
                            <NavLink href="@($"/packages/{pkg.Name}")">@pkg.Name</NavLink>
                            <span> · @pkg.TotalDownloads downloads</span>
                        </li>
                    }
                </ul>
            }
        </FluentCard>
    </FluentGridItem>
</FluentGrid>