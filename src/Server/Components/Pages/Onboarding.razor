@page "/onboarding"
@layout OnboardingLayout
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using pckg.Data

@inject UserManager<ApplicationUser> UserManager
@inject RoleManager<IdentityRole> RoleManager
@inject NavigationManager Navigation

<PageTitle>Initial Setup</PageTitle>

<section class="onboarding-card">
    <header class="section-card-header">
        <h1>Initial setup</h1>
        <p class="muted">Create the first account. This user is automatically granted SuperAdmin.</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="feedback-message @(Success ? "is-success" : "is-error")" role="status" aria-live="polite">@Message</div>
    }

    <EditForm Model="Model" OnValidSubmit="CreateInitialAdminAsync" FormName="onboarding" class="auth-form" novalidate>
        <FluentTextField @bind-Value="Model.Email" Name="PostedModel.Email" Label="Email" Placeholder="admin@example.com" Required Class="auth-form-field" />
        <FluentTextField @bind-Value="Model.Password"
                         Name="PostedModel.Password"
                         Label="Password"
                         TextFieldType="TextFieldType.Password"
                         Placeholder="Create a strong password"
                         Required
                         Class="auth-form-field" />
        <FluentTextField @bind-Value="Model.ConfirmPassword"
                         Name="PostedModel.ConfirmPassword"
                         Label="Confirm password"
                         TextFieldType="TextFieldType.Password"
                         Placeholder="Repeat password"
                         Required
                         Class="auth-form-field" />

        <FluentButton Appearance="Appearance.Accent" Type="ButtonType.Submit">Create SuperAdmin</FluentButton>
    </EditForm>
</section>