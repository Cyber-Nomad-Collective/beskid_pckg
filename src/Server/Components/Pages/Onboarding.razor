@page "/onboarding"
@layout OnboardingLayout
@using Microsoft.AspNetCore.Identity
@using Server.Data

@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

<PageTitle>First-time setup</PageTitle>

<section class="onboarding-card">
    <header class="section-card-header">
        <h1>Welcome</h1>
        <p class="muted">Create the first administrator account for this registry. You will sign in with your email and password.</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="feedback-message @(Success ? "is-success" : "is-error")" role="status" aria-live="polite">@Message</div>
    }

    <form method="post" action="/onboarding/create" class="auth-form" novalidate>
        <FluentTextField Name="displayName" Label="Display name" Placeholder="Your name" Required Class="auth-form-field" />
        <FluentTextField Name="email" Label="Email" Placeholder="you@example.com" Required Class="auth-form-field" />
        <FluentTextField Name="password"
                         Label="Password"
                         TextFieldType="TextFieldType.Password"
                         Placeholder="Create a strong password"
                         Required
                         Class="auth-form-field" />
        <FluentTextField Name="confirmPassword"
                         Label="Confirm password"
                         TextFieldType="TextFieldType.Password"
                         Placeholder="Repeat password"
                         Required
                         Class="auth-form-field" />

        <FluentButton Appearance="Appearance.Accent" Type="ButtonType.Submit">Create administrator</FluentButton>
    </form>
</section>