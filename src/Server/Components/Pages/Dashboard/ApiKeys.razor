@page "/dashboard/api-keys"
@layout DashboardLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@inject IDialogService DialogService
@inject IJSRuntime JsRuntime
@inject HttpClient Http

<PageTitle>API Keys - Dashboard</PageTitle>

<FluentStack Orientation="Orientation.Vertical" Gap="24px">
    <header style="display: flex; justify-content: space-between; align-items: flex-end; width: 100%;">
        <div>
            <h2>API Keys</h2>
            <p class="muted">Manage authentication tokens for publishing packages via CLI.</p>
        </div>
        <FluentButton Appearance="Appearance.Accent" OnClick="OpenGenerateKeyDialogAsync" IconStart="@(new Icons.Regular.Size16.Add())">
            Generate new key
        </FluentButton>
    </header>

    @if (!string.IsNullOrWhiteSpace(FeedbackMessage))
    {
        <div class="feedback-message @(FeedbackIsError ? "is-error" : "is-success")">@FeedbackMessage</div>
    }

    <FluentCard Class="dashboard-card" Style="padding: 24px;">
        @if (ApiKeyItems.Count == 0)
        {
            <div style="text-align: center; padding: 48px 0; color: var(--neutral-foreground-hint);">
                <FluentIcon Value="@(new Icons.Regular.Size32.Key())" Color="Color.Neutral" Style="margin-bottom: 16px; opacity: 0.5; width: 48px; height: 48px;" />
                <h3>No API Keys</h3>
                <p>Generate a key to authenticate via the Beskid CLI and publish packages.</p>
            </div>
        }
        else
        {
            <FluentDataGrid TGridItem="ApiKeyRow" Items="@ApiKeyItems.AsQueryable()" DisplayMode="DataGridDisplayMode.Table">
                <ChildContent>
                    <TemplateColumn Title="Name" Context="key">@key.Name</TemplateColumn>
                    <TemplateColumn Title="Prefix" Context="key"><code>@key.Prefix</code></TemplateColumn>
                    <TemplateColumn Title="Scopes" Context="key">@string.Join(", ", key.Scopes)</TemplateColumn>
                    <TemplateColumn Title="Created" Context="key">@key.CreatedAtUtc.ToString("u")</TemplateColumn>
                    <TemplateColumn Title="Status" Context="key">
                        @if (key.RevokedAtUtc is null)
                        {
                            <FluentBadge Appearance="Appearance.Accent">Active</FluentBadge>
                        }
                        else
                        {
                            <FluentBadge Appearance="Appearance.Neutral">Revoked</FluentBadge>
                        }
                    </TemplateColumn>
                    <TemplateColumn Title="Actions" Context="key">
                        @if (key.RevokedAtUtc is null)
                        {
                            <FluentButton Appearance="Appearance.Outline" Disabled="@IsWorking" OnClick="() => RevokeApiKeyAsync(key.Id)">Revoke</FluentButton>
                        }
                    </TemplateColumn>
                </ChildContent>
            </FluentDataGrid>
        }
    </FluentCard>
</FluentStack>