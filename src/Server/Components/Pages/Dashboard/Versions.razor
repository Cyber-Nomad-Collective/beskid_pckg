@page "/dashboard/packages/versions"
@layout DashboardLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Package Versions - Dashboard</PageTitle>

<FluentStack Orientation="Orientation.Vertical" Gap="24px">
    <header style="display: flex; justify-content: space-between; align-items: flex-end; width: 100%;">
        <div>
            <h2>Package Versions</h2>
            <p class="muted">Inspect published versions and manage release status.</p>
        </div>
        <FluentAnchor Appearance="Appearance.Outline"  Href="/dashboard/packages/new" IconStart="@(new Icons.Regular.Size16.Add())">
            Upload Version
        </FluentAnchor>
    </header>

    <FluentCard Class="dashboard-card" Style="padding: 24px;">
        @if (IsLoading)
        {
            <p class="muted">Loading versions...</p>
        }
        else if (!string.IsNullOrWhiteSpace(FeedbackMessage))
        {
            <p class="feedback-message is-error">@FeedbackMessage</p>
        }
        else
        {
            <FluentDataGrid TGridItem="VersionRow" Items="@VersionItems.AsQueryable()" DisplayMode="DataGridDisplayMode.Table">
                <ChildContent>
                    <TemplateColumn Title="Package" Context="row">@row.PackageName</TemplateColumn>
                    <TemplateColumn Title="Version" Context="row"><code>@row.Version</code></TemplateColumn>
                    <TemplateColumn Title="Published" Context="row">@row.PublishedAtUtc.ToString("u")</TemplateColumn>
                    <TemplateColumn Title="Status" Context="row">
                        <FluentBadge Appearance="@(row.IsYanked ? Appearance.Neutral : Appearance.Accent)">
                            @(row.IsYanked ? "Yanked" : "Active")
                        </FluentBadge>
                    </TemplateColumn>
                    <TemplateColumn Title="Checksum" Context="row"><code>@row.ChecksumSha256[..Math.Min(12, row.ChecksumSha256.Length)]...</code></TemplateColumn>
                </ChildContent>
                <EmptyContent>
                    <span class="muted">No versions published yet.</span>
                </EmptyContent>
            </FluentDataGrid>
        }
    </FluentCard>
</FluentStack>