@page "/dashboard/packages/new"
@layout DashboardLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization

<PageTitle>Upload Version - Dashboard</PageTitle>

<FluentStack Orientation="Orientation.Vertical" Gap="24px">
    <header>
        <h2>Upload Package Version</h2>
        <p class="muted">Manually publish a .bpkg archive to the registry.</p>
    </header>

    <FluentCard Class="dashboard-card" Style="padding: 24px; max-width: 600px;">
        <FluentStack Orientation="Orientation.Vertical" Gap="16px">
            <FluentLabel>Select Package File (.bpkg)</FluentLabel>
            
            <div style="border: 2px dashed var(--neutral-stroke-divider-rest); border-radius: 8px; padding: 48px 24px; text-align: center; background: var(--neutral-fill-layer-rest); cursor: pointer;">
                <FluentIcon Value="@(new Icons.Regular.Size32.ArrowUpload())" Color="Color.Neutral" Style="margin-bottom: 12px; opacity: 0.7;" />
                <p style="margin: 0; font-weight: 600;">Drag and drop or browse to upload</p>
                <p class="muted" style="margin: 4px 0 0 0; font-size: 12px;">Supports .bpkg format generated by `beskid pckg pack`</p>
            </div>

            <div style="margin-top: 16px; display: flex; justify-content: flex-end; gap: 12px;">
                <FluentAnchor Appearance="Appearance.Stealth" Href="/dashboard/packages">Cancel</FluentAnchor>
                <FluentButton Appearance="Appearance.Accent" Disabled="true">Upload & Publish</FluentButton>
            </div>
        </FluentStack>
    </FluentCard>
</FluentStack>
