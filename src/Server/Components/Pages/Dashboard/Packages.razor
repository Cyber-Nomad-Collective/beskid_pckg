@page "/dashboard/packages"
@layout DashboardLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http

<PageTitle>My Packages - Dashboard</PageTitle>

<FluentStack Orientation="Orientation.Vertical" Gap="24px">
    <header style="display: flex; justify-content: space-between; align-items: flex-end; width: 100%;">
        <div>
            <h2>My Packages</h2>
            <p class="muted">Manage packages you have published to the registry.</p>
        </div>
    </header>

    <FluentCard Class="dashboard-card" Style="padding: 24px;">
        @if (IsLoading)
        {
            <p class="muted">Loading packages...</p>
        }
        else if (!string.IsNullOrWhiteSpace(FeedbackMessage))
        {
            <p class="feedback-message is-error">@FeedbackMessage</p>
        }
        else if (PackageItems.Count == 0)
        {
            <div style="text-align: center; padding: 48px 0; color: var(--neutral-foreground-hint);">
                <FluentIcon Value="@(new Icons.Regular.Size32.Box())" Color="Color.Neutral" Style="margin-bottom: 16px; opacity: 0.5; width: 48px; height: 48px;" />
                <h3>No packages yet</h3>
                <p>You haven't published any packages. Create a package via the CLI or upload one manually.</p>
            </div>
        }
        else
        {
            <FluentDataGrid TGridItem="PackageSummaryRow" Items="@PackageItems.AsQueryable()" DisplayMode="DataGridDisplayMode.Table" MultiLine="true">
                <ChildContent>
                    <TemplateColumn Title="Name" Context="package">
                        <div style="display: flex; flex-direction: column; gap: 4px;">
                            <strong>@package.Name</strong>
                            <span class="muted">@package.Description</span>
                        </div>
                    </TemplateColumn>
                    <TemplateColumn Title="Visibility" Context="package">
                        <FluentBadge Appearance="@(package.IsPublic ? Appearance.Accent : Appearance.Neutral)">
                            @(package.IsPublic ? "Public" : "Private")
                        </FluentBadge>
                    </TemplateColumn>
                    <TemplateColumn Title="Updated" Context="package">
                        @package.UpdatedAtUtc.ToString("u")
                    </TemplateColumn>
                    <TemplateColumn Title="Rating" Context="package">
                        @package.AverageRating.ToString("0.00")
                    </TemplateColumn>
                    <TemplateColumn Title="Actions" Context="package">
                        <FluentStack Orientation="Orientation.Horizontal" Gap="8px" Wrap="true">
                            <FluentButton Appearance="Appearance.Outline" OnClick="@(() => StartMetadataEdit(package))">
                                Edit metadata
                            </FluentButton>
                            <FluentButton Appearance="Appearance.Accent" OnClick="@(() => StartVersionUpload(package))">
                                Upload version
                            </FluentButton>
                        </FluentStack>
                    </TemplateColumn>
                </ChildContent>
            </FluentDataGrid>

            @if (!string.IsNullOrWhiteSpace(MetadataFeedbackMessage))
            {
                <p class="feedback-message is-success" style="margin-top: 16px;">@MetadataFeedbackMessage</p>
            }

            @if (!string.IsNullOrWhiteSpace(UploadFeedbackMessage) && UploadingPackageName is null)
            {
                <p class="feedback-message @(UploadFeedbackIsError ? "is-error" : "is-success")" style="margin-top: 16px;">
                    @UploadFeedbackMessage
                </p>
            }

            @if (EditingPackageName is not null)
            {
                <FluentDivider Style="margin: 20px 0;" />

                <FluentCard Class="dashboard-card" Style="padding: 24px; max-width: 900px;">
                    <header>
                        <h3>Edit Metadata: @EditingPackageName</h3>
                        <p class="muted">Update description, links, and visibility for the selected package.</p>
                    </header>

                    <EditForm Model="MetadataForm" OnValidSubmit="SaveMetadataAsync">
                        <FluentStack Orientation="Orientation.Vertical" Gap="16px">
                            <FluentTextField @bind-Value="MetadataForm.PackageName" Label="Package name" Disabled />
                            <FluentTextArea @bind-Value="MetadataForm.Description" Label="Description" Placeholder="Describe what this package provides" />

                            <FluentStack Orientation="Orientation.Horizontal" Gap="12px" Wrap="true">
                                <FluentTextField @bind-Value="MetadataForm.RepositoryUrl" Label="Repository URL" Placeholder="https://..." />
                                <FluentTextField @bind-Value="MetadataForm.WebsiteUrl" Label="Website URL" Placeholder="https://..." />
                            </FluentStack>

                            <FluentSwitch @bind-Value="MetadataForm.IsPublic">Public package</FluentSwitch>

                            <FluentStack Orientation="Orientation.Horizontal" Gap="12px" HorizontalAlignment="HorizontalAlignment.End">
                                <FluentButton Appearance="Appearance.Outline" Type="ButtonType.Button" OnClick="CancelMetadataEdit">Cancel</FluentButton>
                                <FluentButton Appearance="Appearance.Accent" Type="ButtonType.Submit" Disabled="IsSavingMetadata">Save metadata</FluentButton>
                            </FluentStack>
                        </FluentStack>
                    </EditForm>
                </FluentCard>
            }

            @if (UploadingPackageName is not null)
            {
                <FluentDivider Style="margin: 20px 0;" />

                <FluentCard Class="dashboard-card" Style="padding: 24px; max-width: 900px;">
                    <header>
                        <h3>Upload Version: @UploadingPackageName</h3>
                        <p class="muted">Upload a .bpkg artifact and publish a new immutable version.</p>
                    </header>

                    @if (!string.IsNullOrWhiteSpace(UploadFeedbackMessage))
                    {
                        <p class="feedback-message @(UploadFeedbackIsError ? "is-error" : "is-success")" style="margin-top: 12px;">
                            @UploadFeedbackMessage
                        </p>
                    }

                    <EditForm OnValidSubmit="UploadVersionAsync">
                        <FluentStack Orientation="Orientation.Vertical" Gap="16px">
                            <FluentTextField @bind-Value="UploadVersion" Label="Version" Placeholder="1.0.0" Required />
                            <FluentTextField @bind-Value="UploadChecksumSha256" Label="Checksum SHA-256 (optional)" Placeholder="Paste checksum to enforce integrity" />

                            <FluentStack Orientation="Orientation.Vertical" Gap="8px">
                                <FluentLabel>Artifact (.bpkg)</FluentLabel>
                                <InputFile OnChange="HandleArtifactSelected" accept=".bpk,.bpkg,application/zip" />
                                <span class="muted">Max size: 64 MB.</span>
                                @if (!string.IsNullOrWhiteSpace(SelectedArtifactName))
                                {
                                    <span>Selected: @SelectedArtifactName</span>
                                }
                            </FluentStack>

                            <FluentStack Orientation="Orientation.Horizontal" Gap="12px" HorizontalAlignment="HorizontalAlignment.End">
                                <FluentButton Appearance="Appearance.Outline" Type="ButtonType.Button" OnClick="CancelVersionUpload" Disabled="IsUploadingVersion">
                                    Cancel
                                </FluentButton>
                                <FluentButton Appearance="Appearance.Accent" Type="ButtonType.Submit" Disabled="IsUploadingVersion">
                                    @(IsUploadingVersion ? "Uploading..." : "Upload & Publish")
                                </FluentButton>
                            </FluentStack>
                        </FluentStack>
                    </EditForm>
                </FluentCard>
            }
        }
    </FluentCard>
</FluentStack>