@page "/dashboard/packages/my"
@layout DashboardLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization

<PageTitle>My Packages - Dashboard</PageTitle>

<PackageDashboard Title="My Packages"
                    Description="Manage packages you have published to the registry."
                    ShowUploadButton="true"
                    EmptyTitle="No packages yet"
                    EmptyMessage="You haven't published any packages. Create a package via the CLI or upload one manually." />
