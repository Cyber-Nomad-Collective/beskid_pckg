@page "/packages/{PackageName}"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using Server.Data
@using Server.Features.Packages
@using Server.Components.Shared

@inject ApplicationDbContext DbContext
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>@(Package?.Name ?? "Package")</PageTitle>

@if (Package is null)
{
    <FluentCard Class="section-card">
        <h1>Package not found</h1>
        <p>The package <strong>@PackageName</strong> does not exist yet.</p>
    </FluentCard>
}
else
{
    <FluentCard Class="package-header section-card">
        <div class="package-icon-placeholder">@Package.Name[..1].ToUpperInvariant()</div>
        <div style="flex:1;">
            <h1>@Package.Name</h1>
            <p>@Package.Description</p>
            <p>
                <FluentBadge Appearance="Appearance.Accent">@Package.Category</FluentBadge>
                <FluentBadge Appearance="Appearance.Neutral">@Package.TotalDownloads downloads</FluentBadge>
            </p>
        </div>
        @if (IsAuthenticated)
        {
            <div>
                <FluentButton Appearance="@(IsFollowing ? Appearance.Accent : Appearance.Outline)" OnClick="ToggleFollowAsync">
                    @(IsFollowing ? "Following" : "Follow")
                </FluentButton>
            </div>
        }
    </FluentCard>

    <FluentCard Class="section-card">
        <FluentStack Orientation="Orientation.Horizontal" Wrap="true">
            <FluentButton Appearance="@(ActiveTab == "versions" ? Appearance.Accent : Appearance.Outline)" @onclick='() => ActiveTab = "versions"'>Versions</FluentButton>
            <FluentButton Appearance="@(ActiveTab == "dependencies" ? Appearance.Accent : Appearance.Outline)" @onclick='() => ActiveTab = "dependencies"'>Dependencies</FluentButton>
            <FluentButton Appearance="@(ActiveTab == "dependents" ? Appearance.Accent : Appearance.Outline)" @onclick='() => ActiveTab = "dependents"'>Dependents</FluentButton>
            <FluentButton Appearance="@(ActiveTab == "reviews" ? Appearance.Accent : Appearance.Outline)" @onclick='() => ActiveTab = "reviews"'>Reviews</FluentButton>
            <FluentButton Appearance="@(ActiveTab == "voting" ? Appearance.Accent : Appearance.Outline)" @onclick='() => ActiveTab = "voting"'>Feature Voting</FluentButton>
            <FluentButton Appearance="@(ActiveTab == "issues" ? Appearance.Accent : Appearance.Outline)" @onclick='() => ActiveTab = "issues"'>Issues</FluentButton>
        </FluentStack>
    </FluentCard>

    @if (ActiveTab == "versions")
    {
        <FluentCard Class="section-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <h2>Versions</h2>
            </div>
            @if (Versions.Count == 0)
            {
                <p class="muted">No versions published yet.</p>
            }
            else
            {
                <FluentDataGrid TGridItem="PackageVersionSummaryResponse" Items="@Versions.AsQueryable()" DisplayMode="DataGridDisplayMode.Table">
                    <ChildContent>
                        <TemplateColumn Title="Version" Context="version">
                            <strong>@version.Version</strong>
                        </TemplateColumn>
                        <TemplateColumn Title="Status" Context="version">
                            @if (version.IsYanked)
                            {
                                <FluentBadge Appearance="Appearance.Neutral">Yanked</FluentBadge>
                            }
                            else
                            {
                                <FluentBadge Appearance="Appearance.Accent">Active</FluentBadge>
                            }
                        </TemplateColumn>
                        <TemplateColumn Title="Size" Context="version">
                            @(FormatSize(version.SizeBytes))
                        </TemplateColumn>
                        <TemplateColumn Title="Published" Context="version">
                            @version.PublishedAtUtc.ToString("u")
                        </TemplateColumn>
                        <TemplateColumn Title="Actions" Context="version">
                            @if (CanManageVersions)
                            {
                                <FluentButton Appearance="Appearance.Stealth" 
                                              IconStart="@(new Icons.Regular.Size16.Delete())" 
                                              Title="Delete Version"
                                              OnClick="@(() => DeleteVersionAsync(version))" />
                            }
                        </TemplateColumn>
                    </ChildContent>
                </FluentDataGrid>
            }
        </FluentCard>
    }
    else if (ActiveTab == "dependencies")
    {
        <FluentCard Class="section-card">
            <h2>Dependencies</h2>
            <p>No dependency metadata published yet.</p>
        </FluentCard>
    }
    else if (ActiveTab == "dependents")
    {
        <FluentCard Class="section-card">
            <h2>Dependents</h2>
            <p>Dependent package analytics will appear after usage tracking is wired.</p>
        </FluentCard>
    }
    else if (ActiveTab == "reviews")
    {
        <FluentCard Class="section-card">
            <div class="reviews-header-row">
                <h2>Community reviews</h2>
                @if (IsAuthenticated)
                {
                    <FluentButton Appearance="Appearance.Accent" OnClick="OpenReviewDialogAsync" IconStart="@(new Icons.Regular.Size16.Edit())">Write review</FluentButton>
                }
            </div>

            <div class="reviews-summary-card">
                <div class="reviews-summary-score">
                    <div class="reviews-score-value">@AverageReviewRating.ToString("0.0")</div>
                    <FluentRatingPicker ReadOnly="true" Value="@(Convert.ToInt32(Math.Round(AverageReviewRating, MidpointRounding.AwayFromZero)))" />
                    <div class="muted">@Reviews.Count review(s)</div>
                </div>
                <div class="reviews-distribution">
                    @for (var rating = 5; rating >= 1; rating--)
                    {
                        var count = GetReviewCountFor(rating);
                        var width = GetReviewDistributionPercent(rating);
                        <div class="distribution-row">
                            <span class="distribution-label">@rating</span>
                            <div class="distribution-track">
                                <div class="distribution-fill" style="width:@($"{width:0.##}%")"></div>
                            </div>
                            <span class="distribution-count">@count</span>
                        </div>
                    }
                </div>
            </div>

            @if (IsAuthenticated)
            {
                <p class="muted">Your review is public and helps others choose reliable packages.</p>
            }
            @foreach (var review in Reviews)
            {
                <FluentCard Class="review-entry-card">
                    <div class="review-entry-head">
                        <FluentRatingPicker ReadOnly="true" Value="review.Rating" />
                        <span class="muted">@review.CreatedAtUtc.ToString("yyyy-MM-dd")</span>
                    </div>
                    <p>@review.Comment</p>
                </FluentCard>
            }
        </FluentCard>
    }
    else if (ActiveTab == "voting")
    {
        <FluentCard Class="section-card">
            <h2>Feature voting board</h2>
            @if (PackageBoardId <= 0)
            {
                <p class="muted">Discussion board is not available yet.</p>
            }
            else
            {
                <BoardComponent BoardId="PackageBoardId"
                                BoardName="Feature voting"
                                BoardDescription="Request and vote on features for this package."
                                IsLocked="IsPackageBoardLocked"
                                FilterPostType="BoardPostType.FeatureRequest"
                                ShowPostTypeSelector="false"
                                DefaultPostType="BoardPostType.FeatureRequest"
                                NewPostButtonText="New feature request"
                                CreateDialogTitle="Create feature request"
                                EmptyStateText="No feature requests yet. Be the first to suggest one."
                                ViewDiscussionButtonText="View request" />
            }
        </FluentCard>
    }
    else
    {
        <FluentCard Class="section-card">
            <h2>Issue board</h2>
            @if (PackageBoardId <= 0)
            {
                <p class="muted">Discussion board is not available yet.</p>
            }
            else
            {
                <BoardComponent BoardId="PackageBoardId"
                                BoardName="Issues"
                                BoardDescription="Report bugs and discuss package problems with the community."
                                IsLocked="IsPackageBoardLocked"
                                FilterPostType="BoardPostType.Issue"
                                ShowPostTypeSelector="false"
                                DefaultPostType="BoardPostType.Issue"
                                NewPostButtonText="Report issue"
                                CreateDialogTitle="Report issue"
                                EmptyStateText="No issues reported yet."
                                ViewDiscussionButtonText="View issue" />
            }
        </FluentCard>
    }
}