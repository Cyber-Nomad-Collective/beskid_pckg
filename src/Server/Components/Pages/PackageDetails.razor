@page "/packages/{PackageName}"
@rendermode InteractiveServer
@using Server.Data
@using Server.Features.Packages

@inject ApplicationDbContext DbContext
@inject IHttpContextAccessor HttpContextAccessor
@inject Server.Services.IAuthorizationService Authorization
@inject NavigationManager Navigation

<PageTitle>@(Package?.Name ?? "Package")</PageTitle>

@if (Package is null)
{
    <div class="package-empty-state">
        <h1>Package not found</h1>
        <p>The package <strong>@PackageName</strong> does not exist yet.</p>
    </div>
}
else
{
    <div class="package-page-shell">
        <header class="package-header">
            @if (!_packageIconFailed && !string.IsNullOrWhiteSpace(Package.IconUrl))
            {
                <img src="@Package.IconUrl"
                     width="64"
                     height="64"
                     alt=""
                     class="package-icon-image"
                     referrerpolicy="no-referrer"
                     @onerror="OnPackageIconError" />
            }
            @if (_packageIconFailed || string.IsNullOrWhiteSpace(Package.IconUrl))
            {
                <div class="package-icon-placeholder">@Package.Name[..1].ToUpperInvariant()</div>
            }
            <div class="package-hero-main">
                <h1>@Package.Name</h1>
                <p class="package-description">@Package.Description</p>
                <p class="package-publisher-line muted">
                    <PublisherAttribution OwnerUserId="@_ownerPublisherUserId"
                                          DisplayName="@_ownerPublisherDisplayName"
                                          IsVerified="@_ownerPublisherVerified" />
                </p>
                <div class="package-meta-badges">
                    @if (_isTemplatePackage)
                    {
                        <FluentBadge Appearance="Appearance.Accent">Template</FluentBadge>
                    }
                    @if (_isToolPackage)
                    {
                        <FluentBadge Appearance="Appearance.Accent">Tool</FluentBadge>
                    }
                    <FluentBadge Appearance="Appearance.Accent">@Package.Category</FluentBadge>
                    <FluentBadge Appearance="Appearance.Neutral">@Package.TotalDownloads downloads</FluentBadge>
                    @if (HealthStatus is not null)
                    {
                        <FluentBadge Appearance="Appearance.Lightweight">Score @HealthPercent.ToString("0")%</FluentBadge>
                    }
                    @if (!string.IsNullOrWhiteSpace(_heroLatestVersion))
                    {
                        <FluentBadge Appearance="Appearance.Lightweight" Title="Latest non-yanked version">Latest @_heroLatestVersion</FluentBadge>
                    }
                    @if (_firstPublishedAtUtc is not null)
                    {
                        <FluentBadge Appearance="Appearance.Neutral" Title="First version published to the registry">First publish @_firstPublishedAtUtc.Value.ToString("u")</FluentBadge>
                    }
                    @if (_lastPublishedAtUtc is not null)
                    {
                        <FluentBadge Appearance="Appearance.Neutral" Title="Most recent non-yanked publish, or latest publish if all yanked">Last publish @_lastPublishedAtUtc.Value.ToString("u")</FluentBadge>
                    }
                </div>
            </div>
            <div class="package-hero-actions">
                @if (Versions.Count > 0)
                {
                    <div class="package-header-version">
                        <PackageVersionSelect Versions="Versions"
                                              @bind-SelectedVersion="ExplorerVersion"
                                              @bind-SelectedVersion:after="OnExplorerVersionChangedAsync"
                                              AriaLabel="Select package version" />
                    </div>
                }
                @if (IsAuthenticated)
                {
                    <FluentButton Appearance="@(IsFollowing ? Appearance.Accent : Appearance.Outline)" OnClick="ToggleFollowAsync">
                        @(IsFollowing ? "Following" : "Follow")
                    </FluentButton>
                }
            </div>
        </header>

        @if (_isTemplatePackage)
        {
            <FluentCard Class="package-template-card">
                <div class="package-template-head">
                    <h2>Template package</h2>
                    <p class="muted package-template-lead">
                        Install from the registry, then scaffold with <code>beskid new</code>.
                    </p>
                </div>
                <FluentStack Orientation="Orientation.Horizontal" Gap="8" Wrap="true">
                    @if (!string.IsNullOrWhiteSpace(_explorerTemplateShortName))
                    {
                        <FluentBadge Appearance="Appearance.Lightweight" Title="CLI short name">
                            shortName: @_explorerTemplateShortName
                        </FluentBadge>
                    }
                    @if (!string.IsNullOrWhiteSpace(_explorerTemplateTagType))
                    {
                        <FluentBadge Appearance="Appearance.Neutral" Title="Template tags.type">
                            type: @_explorerTemplateTagType
                        </FluentBadge>
                    }
                </FluentStack>
                <div class="package-template-install">
                    <div class="package-embed-label">Install from registry</div>
                    <pre class="package-embed-snippet" tabindex="0">beskid new install @Package.Name</pre>
                    @if (!string.IsNullOrWhiteSpace(_explorerTemplateShortName))
                    {
                        <div class="package-embed-label">Scaffold by short name</div>
                        <pre class="package-embed-snippet" tabindex="0">beskid new @_explorerTemplateShortName</pre>
                    }
                </div>
            </FluentCard>
        }

        @if (_isToolPackage)
        {
            <FluentCard Class="package-template-card">
                <div class="package-template-head">
                    <h2>Tool package</h2>
                    <p class="muted package-template-lead">
                        CLI / developer-tool package. Fetch from the registry, then invoke through the tool's published entrypoint.
                    </p>
                </div>
                <div class="package-template-install">
                    <div class="package-embed-label">Fetch from registry</div>
                    <pre class="package-embed-snippet" tabindex="0">beskid pckg download @Package.Name --version @ExplorerVersion --output ./@(Package.Name).bpk</pre>
                </div>
            </FluentCard>
        }

        <FluentTabs Class="package-tabs" @bind-ActiveTabId="SelectedTabId">
            <FluentTab Id="pkg-tab-readme" Label="Readme">
                <div class="content-section package-tab-content package-readme-tab" aria-label="Package readme">
                    @if (_explorerReadmeLoading)
                    {
                        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" Gap="12">
                            <FluentProgressRing />
                            <FluentLabel Typo="Typography.Body" Class="muted">Loading README…</FluentLabel>
                        </FluentStack>
                    }
                    else if (!string.IsNullOrWhiteSpace(_explorerReadmeError))
                    {
                        <FluentMessageBar Intent="MessageIntent.Warning">@_explorerReadmeError</FluentMessageBar>
                    }
                    else if (!string.IsNullOrWhiteSpace(_explorerReadmeMarkdown))
                    {
                        <FluentCard Class="package-readme-card">
                            <DocMarkdownRegion Markdown="@_explorerReadmeMarkdown" />
                        </FluentCard>
                    }
                    else if (Versions.Count > 0)
                    {
                        <p class="muted package-readme-empty">No README published for this version.</p>
                    }
                </div>
            </FluentTab>

            <FluentTab Id="pkg-tab-versions" Label="Versions">
                <div class="content-section package-tab-content">
                    <div class="content-section-title-row">
                        <h2>Versions</h2>
                    </div>
                    @if (Versions.Count == 0)
                    {
                        <p class="muted">No versions published yet.</p>
                    }
                    else
                    {
                        <FluentDataGrid TGridItem="PackageVersionSummaryResponse" Items="@Versions.AsQueryable()" DisplayMode="DataGridDisplayMode.Table">
                            <ChildContent>
                                <TemplateColumn Title="Version" Context="version">
                                    <strong>@version.Version</strong>
                                </TemplateColumn>
                                <TemplateColumn Title="Status" Context="version">
                                    @if (version.IsYanked)
                                    {
                                        <FluentBadge Appearance="Appearance.Neutral">Yanked</FluentBadge>
                                    }
                                    else
                                    {
                                        <FluentBadge Appearance="Appearance.Accent">Active</FluentBadge>
                                    }
                                </TemplateColumn>
                                <TemplateColumn Title="Size" Context="version">
                                    @(FormatSize(version.SizeBytes))
                                </TemplateColumn>
                                <TemplateColumn Title="Published" Context="version">
                                    @version.PublishedAtUtc.ToString("u")
                                </TemplateColumn>
                                <TemplateColumn Title="Actions" Context="version">
                                    <GridActionOverflowRow Actions="@GetVersionRowActions(version)" />
                                </TemplateColumn>
                            </ChildContent>
                        </FluentDataGrid>
                    }
                </div>
            </FluentTab>

            @if (Package.IsPublic)
            {
                <FluentTab Id="pkg-tab-badges" Label="Badges">
                    <div class="content-section package-tab-content package-badges-tab">
                        <FluentCard Class="package-embed-card">
                            <div class="package-embed-head">
                                <h2 class="package-embed-title">Badges &amp; external sites</h2>
                                <p class="muted package-embed-lead">GitHub-friendly badge (SVG) and an optional iframe card. Scoped names such as <code>@@pckg/…</code> use the <code>package=</code> query parameter so paths stay valid everywhere.</p>
                            </div>
                            <FluentStack Orientation="Orientation.Vertical" Gap="12">
                                <div>
                                    <div class="package-embed-label">Badge (markdown, links to this package)</div>
                                    <pre class="package-embed-snippet" tabindex="0">@EmbedBadgeMarkdownLinked</pre>
                                </div>
                                <div>
                                    <div class="package-embed-label">Badge (markdown, image only)</div>
                                    <pre class="package-embed-snippet" tabindex="0">@EmbedBadgeMarkdownImageOnly</pre>
                                </div>
                                <div>
                                    <div class="package-embed-label">Widget (HTML iframe)</div>
                                    <pre class="package-embed-snippet" tabindex="0">@EmbedWidgetHtml</pre>
                                    <p class="muted package-embed-note">Many README hosts render images reliably; iframes may be stripped or sandboxed.</p>
                                </div>
                                <div class="package-embed-preview-row">
                                    <div class="package-embed-label">Preview</div>
                                    <img src="@EmbedBadgeAbsoluteUrl"
                                         height="20"
                                         alt="pckg registry badge"
                                         referrerpolicy="no-referrer"
                                         class="package-embed-preview-badge" />
                                </div>
                            </FluentStack>
                        </FluentCard>
                    </div>
                </FluentTab>
            }

            <FluentTab Id="pkg-tab-dependencies" Label="Dependencies">
                <div class="content-section package-tab-content">
                    <h2>Dependencies</h2>
                    @if (Dependencies.Count == 0)
                    {
                        <p>No dependency metadata published yet.</p>
                    }
                    else
                    {
                        <FluentDataGrid TGridItem="PackageDependencyResponse" Items="@Dependencies.AsQueryable()" DisplayMode="DataGridDisplayMode.Table">
                            <ChildContent>
                                <PropertyColumn Property="@(x => x.Name)" Title="Package" />
                                <PropertyColumn Property="@(x => x.Version)" Title="Version" />
                                <PropertyColumn Property="@(x => x.Source)" Title="Source" />
                                <PropertyColumn Property="@(x => x.Registry)" Title="Registry" />
                            </ChildContent>
                        </FluentDataGrid>
                    }
                </div>
            </FluentTab>

            <FluentTab Id="pkg-tab-dependents" Label="Dependents">
                <div class="content-section package-tab-content">
                    <h2>Dependents</h2>
                    <p>
                        This package currently has <strong>@DependentsCount</strong> dependent package(s)
                        based on latest published manifests.
                    </p>
                </div>
            </FluentTab>

            @if (!_isTemplatePackage && !_isToolPackage)
            {
                <FluentTab Id="pkg-tab-docs" Label="Documentation">
                    <section class="package-tab-fill package-explorer-tab" aria-label="Package documentation">
                        <header class="package-tab-header">
                            <h2>Documentation</h2>
                            <FluentButton Appearance="Appearance.Accent"
                                          IconStart="@(new Icons.Regular.Size20.Window())"
                                          OnClick="OpenDocsFullPage">
                                Open full page
                            </FluentButton>
                        </header>
                        <PackageDocs PackageIdentifier="@Package.Name"
                                     Version="@ExplorerVersion"
                                     Variant="PackageDocs.PackageDocsVariant.Embedded" />
                    </section>
                </FluentTab>

                <FluentTab Id="pkg-tab-source" Label="Source">
                    <section class="package-tab-fill package-explorer-tab" aria-label="Package source">
                        <h2 class="package-tab-header package-tab-header--title-only">Source</h2>
                        <PackageSourceBrowser PackageIdentifier="@Package.Name"
                                             Version="@ExplorerVersion"
                                             TabActive="@(SelectedTabId == "pkg-tab-source")" />
                    </section>
                </FluentTab>
            }

            <FluentTab Id="pkg-tab-ratings" Label="Ratings">
                <div class="content-section package-tab-content">
                    <div class="reviews-header-row">
                        <h2>Ratings & quality</h2>
                        @if (IsAuthenticated)
                        {
                            <FluentButton Appearance="Appearance.Accent" OnClick="OpenReviewDialogAsync" IconStart="@(new Icons.Regular.Size16.Edit())">Write review</FluentButton>
                        }
                    </div>

                    <div class="reviews-summary-card">
                        <div class="reviews-summary-score">
                            <div class="summary-group-label">Quality score</div>
                            <div class="reviews-score-value">@HealthPercent.ToString("0")%</div>
                            <FluentRatingPicker ReadOnly="true" Value="HealthStars" />
                            @if (HealthStatus is not null)
                            {
                                <div class="muted">@HealthStatus.State • @HealthStatus.SubState</div>
                            }
                            <div class="muted">@Reviews.Count review(s)</div>
                        </div>

                        <div class="reviews-distribution">
                            <div class="summary-group-label">Review distribution</div>
                            @for (var rating = 5; rating >= 1; rating--)
                            {
                                var count = GetReviewCountFor(rating);
                                var width = GetReviewDistributionPercent(rating);
                                <div class="distribution-row">
                                    <span class="distribution-label">@rating</span>
                                    <div class="distribution-track">
                                        <div class="distribution-fill" style="width:@($"{width:0.##}%")"></div>
                                    </div>
                                    <span class="distribution-count">@count</span>
                                </div>
                            }
                        </div>
                    </div>

                    @if (HealthStatus is not null)
                    {
                        <div class="quality-breakdown-card">
                            <div class="summary-group-label">Score decomposition</div>

                            <div class="quality-row">
                                <div class="quality-row-head">
                                    <span>Update cadence</span>
                                    <span class="muted">@((HealthStatus.UpdateRate.Normalized * 100d).ToString("0"))% · w @HealthStatus.UpdateRate.Weight.ToString("0.00")</span>
                                </div>
                                <div class="distribution-track"><div class="distribution-fill" style="width:@($"{HealthStatus.UpdateRate.Normalized * 100d:0.##}%")"></div></div>
                            </div>

                            <div class="quality-row">
                                <div class="quality-row-head">
                                    <span>Downloads momentum</span>
                                    <span class="muted">@((HealthStatus.Downloads.Normalized * 100d).ToString("0"))% · w @HealthStatus.Downloads.Weight.ToString("0.00")</span>
                                </div>
                                <div class="distribution-track"><div class="distribution-fill" style="width:@($"{HealthStatus.Downloads.Normalized * 100d:0.##}%")"></div></div>
                            </div>

                            <div class="quality-row">
                                <div class="quality-row-head">
                                    <span>Review confidence</span>
                                    <span class="muted">@((HealthStatus.Reviews.Normalized * 100d).ToString("0"))% · w @HealthStatus.Reviews.Weight.ToString("0.00")</span>
                                </div>
                                <div class="distribution-track"><div class="distribution-fill" style="width:@($"{HealthStatus.Reviews.Normalized * 100d:0.##}%")"></div></div>
                            </div>
                        </div>
                    }

                    @if (IsAuthenticated)
                    {
                        <p class="muted">Your review is public and helps others choose reliable packages.</p>
                    }
                    @foreach (var review in Reviews)
                    {
                        <FluentCard Class="review-entry-card">
                            <div class="review-entry-head">
                                <FluentRatingPicker ReadOnly="true" Value="review.Rating" />
                                <span class="muted">@review.CreatedAtUtc.ToString("yyyy-MM-dd")</span>
                            </div>
                            <div class="review-entry-body">@RenderReviewHtml(review.Comment)</div>
                        </FluentCard>
                    }
                </div>
            </FluentTab>

            <FluentTab Id="pkg-tab-community" Label="Community">
                <div class="content-section package-tab-content package-community-tab">
                    @if (PackageBoardId <= 0)
                    {
                        <p class="muted">Discussion board is not available yet.</p>
                    }
                    else
                    {
                        <BoardComponent BoardId="PackageBoardId"
                                        BoardName="Community"
                                        BoardDescription="Report issues, request features, and discuss this package with the community."
                                        IsLocked="IsPackageBoardLocked"
                                        CanModerateBoard="CanModerateBoardUser"
                                        OnBoardLockChanged="HandleBoardLockChangedAsync"
                                        ShowPostTypeSelector="true"
                                        DefaultPostType="BoardPostType.Issue"
                                        NewPostButtonText="New thread"
                                        EmptyStateText="No threads yet. Start the first discussion for this package."
                                        ViewDiscussionButtonText="Open thread" />
                    }
                </div>
            </FluentTab>
        </FluentTabs>
    </div>
}