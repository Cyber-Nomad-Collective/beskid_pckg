@page "/profile/{UserId}"
@using Server.Components.Shared

<PageTitle>Public Profile</PageTitle>

<section class="public-profile-page">
    @if (IsLoading)
    {
        <FluentCard Class="public-profile-card">
            <p class="muted">Loading profile...</p>
        </FluentCard>
    }
    else if (!string.IsNullOrWhiteSpace(FeedbackMessage))
    {
        <FluentCard Class="public-profile-card">
            <div class="feedback-message is-error">@FeedbackMessage</div>
        </FluentCard>
    }
    else if (Profile is not null)
    {
        <header class="public-profile-hero">
            <div class="public-profile-hero-inner">
                @if (!string.IsNullOrWhiteSpace(Profile.ProfileImageUrl))
                {
                    <img src="@Profile.ProfileImageUrl" alt="@Profile.DisplayName" class="public-profile-avatar" />
                }
                else
                {
                    <div class="public-profile-avatar public-profile-avatar-placeholder">
                        <FluentIcon Value="@(new Icons.Regular.Size32.Person())" Color="Color.Neutral" />
                    </div>
                }

                <div class="public-profile-title">
                    <h1>@Profile.DisplayName</h1>
                    <p class="muted">Public profile</p>
                    <FluentStack Orientation="Orientation.Horizontal" Gap="8px" Wrap="true">
                        <FluentBadge Appearance="Appearance.Accent">Publisher</FluentBadge>
                    </FluentStack>
                </div>
            </div>
        </header>

        <div class="public-profile-sections">
            <FluentCard Class="public-profile-card">
                <h2>About</h2>
                <p class="muted">@(!string.IsNullOrWhiteSpace(Profile.Bio) ? Profile.Bio : "No profile description yet.")</p>

                @if (Profile.Stats.PackageCount > 0 || Profile.Stats.TotalDownloads > 0)
                {
                    <div class="profile-stats">
                        <div class="stat">
                            <span class="stat-number">@Profile.Stats.PackageCount</span>
                            <span class="stat-label">Packages</span>
                        </div>
                        <div class="stat">
                            <span class="stat-number">@Profile.Stats.TotalDownloads.ToString("N0")</span>
                            <span class="stat-label">Downloads</span>
                        </div>
                    </div>
                }
            </FluentCard>

            @if (Profile.Packages?.Any() == true)
            {
                <FluentCard Class="public-profile-card">
                    <h2>Packages (@Profile.Stats.PackageCount)</h2>
                    <div class="packages-list">
                        @foreach (var package in Profile.Packages)
                        {
                            <div class="package-item">
                                <div class="package-info">
                                    <h3><a href="@($"/packages/{package.Name}")">@package.Name</a></h3>
                                    <p class="muted">@package.Description</p>
                                </div>
                                <div class="package-stats">
                                    <span class="stat">@package.TotalDownloads.ToString("N0") downloads</span>
                                    <span class="stat">@package.AverageRating.ToString("0.0")★</span>
                                </div>
                            </div>
                        }
                    </div>
                </FluentCard>
            }

            @if (Profile.RecentActivity?.Any() == true)
            {
                <FluentCard Class="public-profile-card">
                    <h2>Recent Activity</h2>
                    <div class="activity-list">
                        @foreach (var activity in Profile.RecentActivity)
                        {
                            <div class="activity-item">
                                <div class="activity-icon">
                                    <FluentIcon Value="@GetActivityIcon(activity.Kind)" />
                                </div>
                                <div class="activity-content">
                                    <div class="activity-description">@activity.Label</div>
                                    <div class="activity-detail muted">@activity.Detail</div>
                                    <div class="activity-time">@activity.OccurredAtUtc.ToString("MMM dd, yyyy")</div>
                                </div>
                            </div>
                        }
                    </div>
                </FluentCard>
            }

            <FluentCard Class="public-profile-card">
                <h2>Socials</h2>
                <ul class="public-profile-list">
                    @foreach (var socialLink in SocialLinks)
                    {
                        <li>
                            <TablerIcon Type="@SocialPlatformCatalog.GetIcon(socialLink.Platform)" Class="social-platform-icon" />
                            <a href="@socialLink.Url" target="_blank" rel="noopener noreferrer">@SocialPlatformCatalog.GetDisplayName(socialLink.Platform)</a>
                        </li>
                    }
                    @if (SocialLinks.Count == 0)
                    {
                        <li class="muted">No social links available.</li>
                    }
                </ul>
            </FluentCard>
        </div>
    }
</section>
