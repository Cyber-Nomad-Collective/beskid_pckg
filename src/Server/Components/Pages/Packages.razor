@page "/packages"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using pckg.Data

@inject ApplicationDbContext DbContext

<PageTitle>Browse Packages</PageTitle>

<FluentCard Class="section-card">
    <h1>Browse Packages</h1>
    <p>Search by name, category, or description. Open a package to inspect versions, dependencies, reviews, and feature voting.</p>
    <FluentStack Orientation="Orientation.Horizontal" Wrap="true">
        <FluentSearch @bind-Value="Search" Placeholder="Search packages..." Style="width: 360px;" />
        <FluentButton Appearance="Appearance.Accent" @onclick="LoadAsync">Search</FluentButton>
        <FluentButton Appearance="Appearance.Outline" @onclick="ResetAsync">Reset</FluentButton>
    </FluentStack>
</FluentCard>

<FluentCard Class="section-card">
    @if (Rows.Count == 0)
    {
        <p class="muted">No packages matched your query.</p>
    }
    else
    {
        <table>
            <thead>
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Downloads</th>
                <th>Updated</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var row in Rows)
            {
                <tr>
                    <td>@row.Name</td>
                    <td>@row.Category</td>
                    <td>@row.TotalDownloads</td>
                    <td>@row.UpdatedAtUtc.ToLocalTime().ToString("u")</td>
                    <td><NavLink href="@($"/packages/{row.Name}")">Open</NavLink></td>
                </tr>
            }
            </tbody>
        </table>
    }
</FluentCard>