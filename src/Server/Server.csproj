<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blazored.TextEditor" Version="1.1.3" />
    <PackageReference Include="BlazorMonaco" Version="3.4.0" />
    <PackageReference Include="FastEndpoints" Version="8.0.1" />
    <PackageReference Include="FastEndpoints.Swagger" Version="8.0.1" />
    <PackageReference Include="GoogleCaptchaComponent" Version="6.0.0" />
    <PackageReference Include="HtmlSanitizer" Version="9.0.892" />
    <PackageReference Include="Kebechet.Blazor.Tabler.Icons" Version="3.40.0" />
    <PackageReference Include="Markdig" Version="1.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.7" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.7" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" Version="4.14.0" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" Version="4.14.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.13.13" />
    <PackageReference Include="WolverineFx" Version="5.22.0" />
    <PackageReference Include="WolverineFx.SignalR" Version="5.22.0" />
  </ItemGroup>
  <!-- Ensure files under Features/Packages are compiled even if some environments
       exclude "packages" folders by default; avoid duplicates locally. -->
  <ItemGroup>
    <Compile Remove="Features/Packages/**/*.cs" />
    <Compile Include="Features/Packages/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\pckg.ServiceDefaults\pckg.ServiceDefaults.csproj" />
  </ItemGroup>
  <!-- Optional: emit compile item list when LogCompileItems=true -->
  <PropertyGroup>
    <LogCompileItems>false</LogCompileItems>
  </PropertyGroup>
  <Target Name="PrintCompileItems" BeforeTargets="CoreCompile" Condition="'$(LogCompileItems)'=='true'">
    <Message Importance="High" Text="=== Begin Compile items for $(MSBuildProjectName) ===" />
    <Message Importance="High" Text="DefaultItemExcludes=$(DefaultItemExcludes)" />
    <Message Importance="High" Text="%(Compile.Identity)" />
    <Message Importance="High" Text="=== End Compile items ===" />
  </Target>
</Project>
